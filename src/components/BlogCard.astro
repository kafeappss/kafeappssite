---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import { formatDate, readingTime } from '../scripts/format';

interface Props {
	post: CollectionEntry<'blog'>;
	index?: number;
}

const { post, index = 0 } = Astro.props;
---

<a href={`/blog/${post.id}`} class="card post-card" data-reveal style={`--delay: ${(index % 3) * 0.08}s`}>
	<p class="post-meta mono">
		<time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
		<span aria-hidden="true">·</span>
		<span>{readingTime(post.body)} min de leitura</span>
	</p>
	<h3 class="h3">{post.data.title}</h3>
	<p class="post-desc">{post.data.description}</p>
	<span class="post-more">Ler artigo <Icon name="arrow-up-right" size={18} /></span>
</a>

<style>
	.post-card {
		display: flex;
		flex-direction: column;
		gap: 14px;
		min-height: 100%;
		padding: clamp(24px, 3vw, 34px);
	}

	.post-card:hover {
		border-color: var(--line-strong);
		transform: translateY(-4px);
	}

	.post-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		font-size: 0.72rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--text-dim);
	}

	.post-desc {
		color: var(--text-muted);
		font-size: var(--fs-small);
	}

	.post-more {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		margin-top: auto;
		padding-top: 8px;
		font-size: var(--fs-small);
		font-weight: 500;
		color: var(--crema);
	}
</style>

---
/**
 * Mascotinho do cabeçalho: um círculo discreto com os olhos "//" (os recortes
 * do K), em fonte mono, como as letras do fundo. Ele pisca, segue o cursor e
 * reage (ver src/scripts/mini-mascot.ts). Em telas largas, fica no canto de
 * cima à direita, alinhado com o trilho lateral; nas outras, ao lado do botão
 * e do menu.
 */
---

<div class="mini" data-mini data-mood="idle">
	<button class="mini-face" type="button" data-mini-face aria-label="Mascote da Kafé: clique para ele reagir">
		<span class="mini-eyes" aria-hidden="true">
			<span class="mini-eye" data-mini-eye>/</span>
			<span class="mini-eye" data-mini-eye>/</span>
		</span>
		<span class="mini-z" aria-hidden="true">z</span>
	</button>
	<p class="mini-bubble" data-mini-bubble aria-live="polite"></p>
</div>

<script>
	import '../scripts/mini-mascot';
</script>

<style>
	.mini {
		position: relative;
		flex: none;
	}

	.mini-face {
		position: relative;
		display: grid;
		place-items: center;
		width: 44px;
		height: 44px;
		border-radius: 50%;
		border: 1px solid rgb(var(--fg-rgb) / 0.16);
		background: rgb(var(--bg-rgb) / 0.55);
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		transition:
			border-color 0.3s ease,
			background-color 0.3s ease;
	}

	.mini-face:hover {
		border-color: rgb(var(--fg-rgb) / 0.32);
		background: rgb(var(--fg-rgb) / 0.06);
	}

	.mini-eyes {
		display: flex;
		gap: 2px;
		font-family: var(--font-mono);
		font-size: 15px;
		font-weight: 700;
		line-height: 1;
		color: var(--accent-hover);
		text-shadow: 0 0 10px rgb(var(--brand-rgb) / 0.55);
		transform: translate(var(--look-x, 0px), var(--look-y, 0px));
		transition: transform 0.25s ease-out;
	}

	.mini-eye {
		display: inline-block;
		width: 0.62em;
		text-align: center;
		transition: transform 0.12s ease;
	}

	/* Piscada: os olhos fecham por um instante. */
	.mini[data-blink] .mini-eye {
		transform: scaleY(0.12);
	}

	/* Cochilando: um "z" sobe de vez em quando. */
	.mini-z {
		position: absolute;
		top: -4px;
		right: -2px;
		font-family: var(--font-mono);
		font-size: 10px;
		font-weight: 600;
		color: var(--text-tertiary);
		opacity: 0;
		pointer-events: none;
	}

	.mini[data-mood='sleep'] .mini-z {
		animation: mini-z 2.4s ease-in-out infinite;
	}

	@keyframes mini-z {
		0% {
			opacity: 0;
			transform: translate(0, 4px) scale(0.8);
		}
		30% {
			opacity: 1;
		}
		100% {
			opacity: 0;
			transform: translate(6px, -10px) scale(1.15);
		}
	}

	/* Movimentos (o círculo inteiro). */
	.mini[data-anim='nod'] .mini-face {
		animation: mini-nod 0.9s ease-in-out;
	}

	.mini[data-anim='bounce'] .mini-face {
		animation: mini-bounce 0.7s var(--ease-out);
	}

	.mini[data-anim='spin'] .mini-face {
		animation: mini-spin 0.8s var(--ease-in-out);
	}

	.mini[data-anim='shake'] .mini-face {
		animation: mini-shake 0.7s ease-in-out;
	}

	.mini[data-anim='wobble'] .mini-face {
		animation: mini-wobble 1.2s ease-in-out;
	}

	.mini[data-anim='giggle'] .mini-face {
		animation: mini-giggle 0.5s ease-in-out;
	}

	@keyframes mini-nod {
		25%,
		75% {
			transform: translateY(4px);
		}
		50% {
			transform: translateY(-1px);
		}
	}

	@keyframes mini-bounce {
		30% {
			transform: translateY(-7px) scale(1.04);
		}
		55% {
			transform: translateY(0) scale(0.97, 1.03);
		}
		75% {
			transform: translateY(-2px);
		}
	}

	@keyframes mini-spin {
		to {
			transform: rotate(360deg);
		}
	}

	@keyframes mini-shake {
		20%,
		60% {
			transform: translateX(-4px) rotate(-6deg);
		}
		40%,
		80% {
			transform: translateX(4px) rotate(6deg);
		}
	}

	@keyframes mini-wobble {
		25% {
			transform: rotate(-14deg);
		}
		50% {
			transform: rotate(10deg);
		}
		75% {
			transform: rotate(-6deg);
		}
	}

	@keyframes mini-giggle {
		25%,
		75% {
			transform: rotate(-5deg) scale(1.03);
		}
		50% {
			transform: rotate(5deg) scale(1.03);
		}
	}

	/* Balão de fala, logo abaixo do círculo. */
	.mini-bubble {
		position: absolute;
		top: calc(100% + 12px);
		right: 0;
		z-index: 5;
		width: max-content;
		max-width: min(250px, calc(100vw - 32px));
		padding: 9px 13px;
		border-radius: 12px;
		background: var(--white);
		color: var(--black);
		font-size: 0.84rem;
		font-weight: 600;
		line-height: 1.35;
		letter-spacing: -0.01em;
		box-shadow: 0 16px 36px -12px rgb(0 0 0 / 0.6);
		opacity: 0;
		transform: translateY(-4px) scale(0.96);
		transform-origin: top right;
		transition:
			opacity 0.25s ease,
			transform 0.35s var(--ease-out);
		pointer-events: none;
	}

	.mini-bubble::before {
		content: '';
		position: absolute;
		top: -5px;
		right: 17px;
		width: 10px;
		height: 10px;
		background: var(--white);
		transform: rotate(45deg);
	}

	.mini-bubble.is-visible {
		opacity: 1;
		transform: none;
	}

	/* Telas largas: no canto de cima à direita, alinhado com o trilho lateral.
	   (Dentro do cabeçalho: some e volta junto com ele ao rolar.) */
	@media (min-width: 1480px) {
		.mini {
			position: fixed;
			top: calc((var(--header-h) - 44px) / 2);
			right: 16px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.mini-eyes {
			transition: none;
		}
	}
</style>

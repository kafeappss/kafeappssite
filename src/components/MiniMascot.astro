---
/**
 * Mascotinho: um círculo discreto com os olhos "//" (os recortes do K), em
 * fonte mono, como as letras do fundo. Ele pisca, segue o cursor e reage (ver
 * src/scripts/mini-mascot.ts). Em telas largas fica sempre no canto de cima à
 * direita, alinhado com o trilho lateral; nas outras, no cabeçalho, ao lado do
 * menu (ocupando o espaço reservado em Header.astro, .mini-slot).
 *
 * Clicar nele (ou ⌘K / Ctrl+K) abre um painel para buscar no site, tirar
 * dúvidas rápidas sobre a Kafé e falar com a equipe (src/scripts/mini-panel.ts).
 * Tudo o que aparece no painel vem dos dados do site: contatos, serviços,
 * perguntas frequentes e artigos do blog.
 */
import { getCollection } from 'astro:content';
import Icon, { type IconKey } from './Icon.astro';
import { clients, site, technologies, whatsappLink } from '../data/site';
import { services } from '../data/services';
import { faq } from '../data/method';
import { hasCases } from '../scripts/cases';

type Item = {
	title: string;
	sub?: string;
	icon: IconKey;
	href?: string;
	external?: boolean;
	/** Perguntas: a resposta aparece dentro do painel. */
	answer?: string;
	/** Palavras extras para a busca. */
	keys?: string;
	/** Ganha prioridade quando a pessoa pede contato ou fala de preço. */
	intent?: 'contact' | 'price';
};

const norm = (text: string) =>
	text
		.normalize('NFD')
		.replace(/[̀-ͯ]/g, '')
		.toLowerCase()
		.replace(/[^a-z0-9@.]+/g, ' ')
		.trim();

const whatsapp = whatsappLink();
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const contact: Item[] = [
	...(whatsapp
		? [
				{
					title: 'Chamar no WhatsApp',
					sub: site.contact.phoneDisplay || 'Resposta rápida, sem compromisso',
					icon: 'whatsapp',
					href: whatsapp,
					external: true,
					keys: 'whatsapp zap wpp whats chamar conversar falar mensagem telefone celular atendimento humano pessoa',
					intent: 'contact',
				} satisfies Item,
			]
		: []),
	{
		title: 'Fazer um pré-orçamento',
		sub: 'Com a Kafeína, nossa IA, em uns 2 minutos',
		icon: 'rocket',
		href: site.contact.briefUrl,
		keys: 'orcamento preco valor custo quanto custa proposta projeto comecar estimativa investimento',
		intent: 'price',
	},
	{
		title: 'Mandar um e-mail',
		sub: site.contact.email,
		icon: 'mail',
		href: `mailto:${site.contact.email}`,
		keys: 'email e-mail contato mandar escrever falar',
		intent: 'contact',
	},
	{
		title: 'Ir para a página de contato',
		sub: 'Formulário, e-mail e redes',
		icon: 'chat',
		href: '/contato',
		keys: 'contato formulario falar conversar mensagem atendimento',
		intent: 'contact',
	},
];

const explore: Item[] = [
	{ title: 'Serviços', sub: 'Apps, sistemas, sites e IA sob medida', icon: 'blocks', href: '/servicos', keys: 'servicos o que fazem solucoes app apps aplicativo site sistema plataforma ia' },
	{ title: 'Método 4Ds', sub: 'Discovery, Design, Develop e Deploy', icon: 'k', href: '/metodo', keys: 'metodo metodologia 4ds processo etapas como trabalham sprint ongoing' },
	...(hasCases ? [{ title: 'Cases', sub: 'Projetos que já entregamos', icon: 'spark', href: '/cases', keys: 'cases portfolio projetos trabalhos resultados' } satisfies Item] : []),
	{ title: 'Sobre a Kafé', sub: 'Quem somos e como pensamos', icon: 'chat', href: '/sobre', keys: 'sobre quem somos empresa equipe time historia' },
	{ title: 'Blog', sub: 'Artigos sobre produto, código e IA', icon: 'pen', href: '/blog', keys: 'blog artigos conteudo textos' },
];

const facts: Item[] = [
	{
		title: 'Onde fica a Kafé?',
		icon: 'pin',
		answer: `Nossa base é em ${site.location.city} (${site.location.state}), e trabalhamos de forma remota com empresas de todo o Brasil, com reuniões on-line e acompanhamento em tempo real.`,
		keys: 'onde fica endereco cidade localizacao jaragua sc santa catarina remoto brasil',
	},
	{
		title: 'Desde quando a Kafé existe?',
		icon: 'clock',
		answer: `Desde ${site.foundingYear}. De lá para cá, lançamos produtos para startups e empresas de vários setores, com a nossa metodologia 4Ds.`,
		keys: 'quando fundada fundacao historia anos tempo experiencia existe',
	},
	{
		title: 'Quais tecnologias vocês usam?',
		icon: 'gear',
		answer: `Trabalhamos em código, com ${technologies.join(', ')}, entre outras. A escolha depende do produto: a gente indica a arquitetura certa na etapa de Discovery.`,
		keys: 'tecnologias stack linguagens ferramentas react next supabase firebase aws openai anthropic nocode no code codigo',
	},
	{
		title: 'Quem já trabalhou com a Kafé?',
		icon: 'check',
		answer: `Empresas como ${clients.map((client) => client.name).join(', ')}.`,
		keys: 'clientes empresas portfolio atendidas quem confia referencias',
	},
];

const questions: Item[] = faq.map((item) => ({ title: item.q, icon: 'spark', answer: item.a }));

const pages: Item[] = services.map((service) => ({
	title: service.title,
	sub: service.short,
	icon: service.icon,
	href: `/servicos/${service.slug}`,
	keys: `${service.keywords.join(' ')} ${service.seo.description} ${service.slug.replace(/-/g, ' ')}`,
}));

const serviceQuestions: Item[] = services.flatMap((service) =>
	service.faq.map((item) => ({ title: item.q, icon: 'spark' as IconKey, answer: item.a, keys: service.title })),
);

const articles: Item[] = posts.map((post) => ({
	title: post.data.title,
	sub: post.data.description,
	icon: 'pen',
	href: `/blog/${post.id}`,
	keys: `artigo blog ${post.data.tags.join(' ')}`,
}));

const socialIcon: Record<string, IconKey> = {
	Instagram: 'instagram',
	LinkedIn: 'linkedin',
	YouTube: 'youtube',
	Facebook: 'facebook',
};
const social: Item[] = site.social.map((item) => ({
	title: item.label,
	sub: item.handle,
	icon: socialIcon[item.label] ?? 'arrow-up-right',
	href: item.href,
	external: true,
	keys: 'redes sociais rede social seguir podcast podkafe',
}));

const more: Item[] = [
	{ title: 'Página inicial', icon: 'arrow', href: '/', keys: 'inicio home comeco' },
	{ title: 'Política de privacidade', icon: 'check', href: '/privacidade', keys: 'privacidade lgpd dados cookies' },
];

/** Tudo o que a busca encontra, na ordem de desempate (sem títulos repetidos). */
const searchable = [...contact, ...explore, ...facts, ...questions, ...pages, ...articles, ...serviceQuestions, ...social, ...more].filter(
	(item, index, list) => list.findIndex((other) => other.title === item.title) === index,
);
/** O cartão de destaque: WhatsApp, se houver número; senão, o pré-orçamento. */
const hero = whatsapp ? contact[0] : contact.find((item) => item.intent === 'price')!;
/** Perguntas que aparecem antes de a pessoa digitar. */
const quick = [faq[0], faq[2], faq[1], faq[5]].map((item) => questions[faq.indexOf(item)]).concat(facts[0]);

const shortcuts: { label: string; icon: IconKey; href: string; external?: boolean }[] = [
	...(whatsapp ? [{ label: 'WhatsApp', icon: 'whatsapp' as IconKey, href: whatsapp, external: true }] : []),
	{ label: 'E-mail', icon: 'mail', href: `mailto:${site.contact.email}` },
	{ label: 'Pré-orçamento', icon: 'rocket', href: site.contact.briefUrl },
	{ label: 'Serviços', icon: 'blocks', href: '/servicos' },
	{ label: 'Método', icon: 'k', href: '/metodo' },
	{ label: 'Blog', icon: 'pen', href: '/blog' },
	...social.slice(0, 2).map((item) => ({ label: item.title, icon: item.icon, href: item.href!, external: true })),
];
---

<div class="mini" data-mini data-mood="idle">
	<button
		class="mini-face"
		type="button"
		data-mini-face
		aria-label="Mascote da Kafé: abrir busca e atalhos"
		aria-expanded="false"
		aria-controls="mini-panel"
	>
		<span class="mini-eyes" aria-hidden="true">
			<span class="mini-eye" data-mini-eye>/</span>
			<span class="mini-eye" data-mini-eye>/</span>
		</span>
		<span class="mini-z" aria-hidden="true">z</span>
	</button>
	<p class="mini-bubble" data-mini-bubble aria-live="polite"></p>
</div>

<div
	class="mini-panel"
	id="mini-panel"
	role="dialog"
	aria-label="Busca e atalhos da Kafé"
	data-mini-panel
	data-whatsapp={site.contact.whatsapp}
	hidden
>
	<div class="mini-top">
		<span class="mini-chip"><span class="mini-chip-eyes" aria-hidden="true">//</span> Kafé Apps</span>
		<div class="mini-search">
			<Icon name="spark" size={18} class="mini-search-icon" />
			<input
				class="mini-input"
				type="text"
				placeholder="O que você procura?"
				aria-label="O que você procura?"
				autocomplete="off"
				spellcheck="false"
				enterkeyhint="go"
				data-mini-input
			/>
			<button class="mini-esc" type="button" data-mini-close aria-label="Fechar">
				<span class="mini-esc-key">Esc</span>
				<Icon name="close" size={18} class="mini-esc-icon" />
			</button>
		</div>
	</div>

	<div class="mini-body" data-mini-body>
		<!-- Antes de digitar: atalhos, contato, páginas e perguntas rápidas. -->
		<div class="mini-view" data-mini-home>
			<a class="mini-hero mini-item" href={whatsapp || site.contact.briefUrl} target={whatsapp ? '_blank' : undefined} rel={whatsapp ? 'noopener' : undefined} data-cmd>
				<span class="mini-dot" aria-hidden="true"></span>
				<span class="mini-text">
					<strong>{whatsapp ? 'Fale com a gente agora' : 'Começar meu projeto'}</strong>
					<small>{whatsapp ? site.contact.phoneDisplay || 'WhatsApp · resposta rápida' : 'Pré-orçamento com a Kafeína em 2 min'}</small>
				</span>
				<Icon name={whatsapp ? 'whatsapp' : 'arrow'} size={20} class="mini-hero-icon" />
			</a>

			<p class="mini-label">Atalhos</p>
			<ul role="list" class="mini-shortcuts">
				{
					shortcuts.map((item) => (
						<li>
							<a
								class="mini-round"
								href={item.href}
								target={item.external ? '_blank' : undefined}
								rel={item.external ? 'noopener' : undefined}
								aria-label={item.label}
								data-tip={item.label}
								data-cmd
							>
								<Icon name={item.icon} size={18} />
							</a>
						</li>
					))
				}
			</ul>

			<p class="mini-label">Fale com a gente</p>
			<ul role="list" class="mini-list">
				{
					contact.filter((item) => item !== hero).map((item) => (
						<li>
							<a class="mini-item" href={item.href} target={item.external ? '_blank' : undefined} rel={item.external ? 'noopener' : undefined} data-cmd>
								<Icon name={item.icon} size={18} class="mini-icon" />
								<span class="mini-text">
									<span>{item.title}</span>
									{item.sub && <small>{item.sub}</small>}
								</span>
							</a>
						</li>
					))
				}
			</ul>

			<p class="mini-label">Explorar</p>
			<ul role="list" class="mini-list">
				{
					explore.map((item) => (
						<li>
							<a class="mini-item" href={item.href} data-cmd>
								<Icon name={item.icon} size={18} class="mini-icon" />
								<span class="mini-text">
									<span>{item.title}</span>
								</span>
								<small class="mini-hint">{item.sub}</small>
							</a>
						</li>
					))
				}
			</ul>

			<p class="mini-label">Perguntas rápidas</p>
			<ul role="list" class="mini-list">
				{
					quick.map((item) => (
						<li>
							<button class="mini-item" type="button" data-cmd data-q={item.title} data-a={item.answer}>
								<Icon name={item.icon} size={18} class="mini-icon" />
								<span class="mini-text">
									<span>{item.title}</span>
								</span>
							</button>
						</li>
					))
				}
			</ul>
		</div>

		<!-- Ao digitar: os resultados da busca (a ordem é ajustada pelo script). -->
		<div class="mini-view" data-mini-search hidden>
			<p class="mini-label" data-mini-count>Resultados</p>
			<ul role="list" class="mini-list mini-results">
				{
					searchable.map((item) => (
						<li hidden data-t={norm(item.title)} data-k={norm(`${item.sub ?? ''} ${item.keys ?? ''} ${item.answer ?? ''}`)} data-intent={item.intent}>
							{item.answer ? (
								<button class="mini-item" type="button" data-cmd data-q={item.title} data-a={item.answer}>
									<Icon name={item.icon} size={18} class="mini-icon" />
									<span class="mini-text">
										<span>{item.title}</span>
									</span>
								</button>
							) : (
								<a class="mini-item" href={item.href} target={item.external ? '_blank' : undefined} rel={item.external ? 'noopener' : undefined} data-cmd>
									<Icon name={item.icon} size={18} class="mini-icon" />
									<span class="mini-text">
										<span>{item.title}</span>
										{item.sub && <small>{item.sub}</small>}
									</span>
								</a>
							)}
						</li>
					))
				}
			</ul>
			<p class="mini-empty" data-mini-empty hidden>Não achei isso por aqui. Pergunta direto pra equipe:</p>
			<ul role="list" class="mini-list">
				<li>
					<a class="mini-item mini-ask" href="/contato" data-cmd data-mini-ask>
						<Icon name={whatsapp ? 'whatsapp' : 'chat'} size={18} class="mini-icon" />
						<span class="mini-text">
							<span>{whatsapp ? 'Perguntar no WhatsApp' : 'Perguntar pra equipe'}</span>
							<small data-mini-ask-text></small>
						</span>
						<Icon name="arrow" size={16} class="mini-go" />
					</a>
				</li>
			</ul>
		</div>

		<!-- Resposta de uma pergunta. -->
		<div class="mini-view mini-answer" data-mini-answer hidden>
			<button class="mini-back" type="button" data-mini-back data-cmd>
				<Icon name="arrow" size={16} /> Voltar
			</button>
			<p class="mini-q" data-mini-q></p>
			<p class="mini-a" data-mini-a></p>
			<a class="mini-item mini-ask" href="/contato" data-cmd data-mini-ask-answer>
				<Icon name={whatsapp ? 'whatsapp' : 'chat'} size={18} class="mini-icon" />
				<span class="mini-text">
					<span>Falar com a equipe sobre isso</span>
					<small>{whatsapp ? 'No WhatsApp, com a pergunta pronta' : 'Na página de contato, com a pergunta pronta'}</small>
				</span>
				<Icon name="arrow" size={16} class="mini-go" />
			</a>
		</div>
	</div>

	<div class="mini-foot">
		<span class="mini-tip"><span class="mini-tip-eyes" aria-hidden="true" data-mini-tip-eyes>^ ^</span> <span data-mini-tip></span></span>
		<span class="mini-keys" aria-hidden="true" title="↑ ↓ escolhem, Enter abre"><kbd>↑</kbd><kbd>↓</kbd><kbd>↵</kbd></span>
	</div>
</div>

<script>
	import '../scripts/mini-mascot';
</script>

<style>
	/* ------------------------------------------------------------------
	   O círculo com os olhos
	   ------------------------------------------------------------------ */

	.mini {
		--mini-size: 36px;
		position: fixed;
		top: calc((var(--header-h) - var(--mini-size)) / 2);
		right: calc(var(--gutter) + 56px);
		z-index: 101;
		transition:
			transform 0.8s var(--ease-out),
			opacity 0.6s ease;
	}

	/* Celular e tablet: some e volta junto com o cabeçalho ao rolar. */
	:global(.site-header.is-hidden) ~ .mini {
		transform: translateY(calc(-1 * var(--header-h)));
		opacity: 0;
		transition:
			transform 0.45s cubic-bezier(0.4, 0, 1, 1),
			opacity 0.35s ease;
	}

	@media (min-width: 1024px) {
		.mini {
			right: var(--gutter);
		}
	}

	/* Telas largas: sempre no canto de cima à direita, alinhado com o trilho. */
	@media (min-width: 1100px) {
		.mini,
		:global(.site-header.is-hidden) ~ .mini {
			right: 8px;
			transform: none;
			opacity: 1;
		}
	}

	.mini-face {
		position: relative;
		display: grid;
		place-items: center;
		width: var(--mini-size);
		height: var(--mini-size);
		border-radius: 50%;
		border: 1px solid rgb(var(--fg-rgb) / 0.2);
		background: rgb(2 2 2 / 0.92);
		box-shadow:
			0 0 0 1px rgb(0 0 0 / 0.9),
			0 6px 18px -6px rgb(0 0 0 / 0.7);
		transition: border-color 0.3s ease;
	}

	.mini-face:hover,
	.mini-face[aria-expanded='true'] {
		border-color: rgb(var(--fg-rgb) / 0.4);
	}

	.mini-eyes {
		display: flex;
		gap: 1px;
		font-family: var(--font-mono);
		font-size: 13px;
		font-weight: 700;
		line-height: 1;
		color: var(--accent-hover);
		text-shadow: 0 0 10px rgb(var(--brand-rgb) / 0.55);
		transform: translate(var(--look-x, 0px), var(--look-y, 0px));
		transition: transform 0.25s ease-out;
	}

	.mini-eye {
		display: inline-block;
		width: 0.62em;
		text-align: center;
		transition: transform 0.12s ease;
	}

	/* Piscada: os olhos fecham por um instante. */
	.mini[data-blink] .mini-eye {
		transform: scaleY(0.12);
	}

	/* Cochilando: um "z" sobe de vez em quando. */
	.mini-z {
		position: absolute;
		top: -4px;
		right: -2px;
		font-family: var(--font-mono);
		font-size: 10px;
		font-weight: 600;
		color: var(--text-tertiary);
		opacity: 0;
		pointer-events: none;
	}

	.mini[data-mood='sleep'] .mini-z {
		animation: mini-z 2.4s ease-in-out infinite;
	}

	@keyframes mini-z {
		0% {
			opacity: 0;
			transform: translate(0, 4px) scale(0.8);
		}
		30% {
			opacity: 1;
		}
		100% {
			opacity: 0;
			transform: translate(6px, -10px) scale(1.15);
		}
	}

	/* Movimentos (o círculo inteiro). */
	.mini[data-anim='nod'] .mini-face {
		animation: mini-nod 0.9s ease-in-out;
	}

	.mini[data-anim='bounce'] .mini-face {
		animation: mini-bounce 0.7s var(--ease-out);
	}

	.mini[data-anim='spin'] .mini-face {
		animation: mini-spin 0.8s var(--ease-in-out);
	}

	.mini[data-anim='shake'] .mini-face {
		animation: mini-shake 0.7s ease-in-out;
	}

	.mini[data-anim='wobble'] .mini-face {
		animation: mini-wobble 1.2s ease-in-out;
	}

	.mini[data-anim='giggle'] .mini-face {
		animation: mini-giggle 0.5s ease-in-out;
	}

	@keyframes mini-nod {
		25%,
		75% {
			transform: translateY(4px);
		}
		50% {
			transform: translateY(-1px);
		}
	}

	@keyframes mini-bounce {
		30% {
			transform: translateY(-7px) scale(1.04);
		}
		55% {
			transform: translateY(0) scale(0.97, 1.03);
		}
		75% {
			transform: translateY(-2px);
		}
	}

	@keyframes mini-spin {
		to {
			transform: rotate(360deg);
		}
	}

	@keyframes mini-shake {
		20%,
		60% {
			transform: translateX(-4px) rotate(-6deg);
		}
		40%,
		80% {
			transform: translateX(4px) rotate(6deg);
		}
	}

	@keyframes mini-wobble {
		25% {
			transform: rotate(-14deg);
		}
		50% {
			transform: rotate(10deg);
		}
		75% {
			transform: rotate(-6deg);
		}
	}

	@keyframes mini-giggle {
		25%,
		75% {
			transform: rotate(-5deg) scale(1.03);
		}
		50% {
			transform: rotate(5deg) scale(1.03);
		}
	}

	/* Balão de fala escuro, logo abaixo do círculo. */
	.mini-bubble {
		position: absolute;
		top: calc(100% + 12px);
		right: 0;
		width: max-content;
		max-width: min(250px, calc(100vw - 32px));
		padding: 9px 13px;
		border: 1px solid var(--line-strong);
		border-radius: 12px;
		background: rgb(14 15 17 / 0.96);
		color: var(--text);
		font-size: 0.84rem;
		font-weight: 500;
		line-height: 1.4;
		letter-spacing: -0.01em;
		box-shadow: 0 18px 40px -14px rgb(0 0 0 / 0.8);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		opacity: 0;
		transform: translateY(-4px) scale(0.96);
		transform-origin: top right;
		transition:
			opacity 0.25s ease,
			transform 0.35s var(--ease-out);
		pointer-events: none;
	}

	.mini-bubble::before {
		content: '';
		position: absolute;
		top: -6px;
		right: calc(var(--mini-size) / 2 - 6px);
		width: 10px;
		height: 10px;
		border-top: 1px solid var(--line-strong);
		border-left: 1px solid var(--line-strong);
		background: rgb(14 15 17);
		transform: rotate(45deg);
	}

	.mini-bubble.is-visible {
		opacity: 1;
		transform: none;
	}

	/* ------------------------------------------------------------------
	   Painel de busca e atalhos
	   ------------------------------------------------------------------ */

	.mini-panel {
		position: fixed;

---
import { clients } from '../data/site';

// Logos em src/assets/clients/*.svg, desenhados em currentColor (branco no site).
const logos = import.meta.glob<{ default: (props: Record<string, unknown>) => unknown }>('../assets/clients/*.svg', {
	eager: true,
});
const logoFor = (key: string) => logos[`../assets/clients/${key}.svg`]?.default;
---

{
	clients.length > 0 && (
		<ul role="list" class="clients">
			{clients.map((client, index) => {
				const Logo = logoFor(client.logo) as any;
				return (
					<li data-reveal style={`--delay: ${(index % 4) * 0.05}s; --size: ${client.size ?? 1}`}>
						{Logo ? <Logo role="img" aria-label={client.name} /> : <span>{client.name}</span>}
					</li>
				);
			})}
			<li class="clients-more" data-reveal>
				<a href="/contato">
					<span>Sua empresa</span>
					<small>pode ser a próxima →</small>
				</a>
			</li>
		</ul>
	)
}

<style>
	.clients {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		border-top: 1px solid var(--line);
		border-left: 1px solid var(--line);
	}

	.clients li {
		display: grid;
		place-items: center;
		min-height: 128px;
		padding: 28px 20px;
		border-right: 1px solid var(--line);
		border-bottom: 1px solid var(--line);
		color: var(--gray-300);
		background: rgb(0 0 0 / 0.35);
		transition:
			color 0.3s ease,
			background-color 0.3s ease;
	}

	.clients li:hover {
		color: var(--white);
		background: rgb(255 255 255 / 0.03);
	}

	.clients :global(svg) {
		width: auto;
		height: calc(34px * var(--size, 1));
		max-width: 100%;
	}

	.clients-more a {
		display: grid;
		gap: 4px;
		text-align: center;
		font-weight: 600;
		letter-spacing: -0.02em;
		color: var(--text);
	}

	.clients-more small {
		font-size: var(--fs-xs);
		font-weight: 500;
		color: var(--text-dim);
	}

	@media (min-width: 720px) {
		.clients {
			grid-template-columns: repeat(3, 1fr);
		}
	}

	@media (min-width: 1080px) {
		.clients {
			grid-template-columns: repeat(4, 1fr);
		}
	}
</style>

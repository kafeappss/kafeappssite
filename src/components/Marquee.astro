---
import Icon from './Icon.astro';

interface Props {
	items: string[];
	reverse?: boolean;
}

const { items, reverse = false } = Astro.props;
---

<div class:list={['marquee', { reverse }]} aria-hidden="true">
	{
		[0, 1].map(() => (
			<ul class="marquee-track">
				{items.map((item) => (
					<li>
						<span>{item}</span>
						<Icon name="sparkle" size={14} class="marquee-star" />
					</li>
				))}
			</ul>
		))
	}
</div>

<style>
	.marquee {
		display: flex;
		overflow: hidden;
		padding-block: 26px;
		border-block: 1px solid var(--line);
		-webkit-mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
		mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
		background: rgb(11 8 6 / 0.35);
	}

	.marquee-track {
		display: flex;
		flex: none;
		gap: 0;
		padding: 0;
		list-style: none;
		animation: marquee 48s linear infinite;
	}

	.reverse .marquee-track {
		animation-direction: reverse;
	}

	.marquee-track li {
		display: flex;
		align-items: center;
		gap: 36px;
		padding-right: 36px;
		white-space: nowrap;
		font-size: clamp(1.2rem, 1rem + 1vw, 1.9rem);
		font-weight: 450;
		letter-spacing: -0.03em;
		color: var(--text-muted);
	}

	.marquee-track li:nth-child(even) span {
		font-family: var(--font-serif);
		font-style: italic;
		color: var(--crema);
	}

	.marquee :global(.marquee-star) {
		color: var(--caramel);
		opacity: 0.8;
	}

	@keyframes marquee {
		to {
			transform: translateX(-100%);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.marquee-track {
			animation: none;
		}
	}
</style>

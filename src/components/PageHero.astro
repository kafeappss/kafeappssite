---
import LiquidSlot from './LiquidSlot.astro';
import { site } from '../data/site';

interface Props {
	eyebrow: string;
	/** Aceita <em> para o destaque em itálico. */
	title: string;
	lead?: string;
	breadcrumbs?: { label: string; href?: string }[];
	/** Formação do líquido (ex.: "phone", "page"). */
	liquid?: string;
	/** Nome da etapa no trilho lateral. */
	rail?: string;
}

const { eyebrow, title, lead, breadcrumbs = [], liquid = 'page', rail } = Astro.props;

// Formas livres ("page", "rest") ocupam a tela toda; as demais ganham um espaço ao lado do título.
const hasSlot = !['page', 'rest', 'pool'].includes(liquid);
const trail = [{ label: 'Início', href: '/' }, ...breadcrumbs];
const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: trail.map((item, index) => ({
		'@type': 'ListItem',
		position: index + 1,
		name: item.label,
		item: item.href ? new URL(item.href, site.url).href : new URL(Astro.url.pathname, site.url).href,
	})),
};
---

<section class:list={['page-hero', { 'has-slot': hasSlot }]} data-liquid={liquid} data-rail={rail} data-horizon="0.13">
	<div class="container page-hero-inner">
		<div class="page-hero-copy">
		{
			breadcrumbs.length > 0 && (
				<nav class="breadcrumbs" aria-label="Você está em" data-reveal>
					<ol role="list">
						{trail.map((item) => (
							<li>{item.href ? <a href={item.href}>{item.label}</a> : <span aria-current="page">{item.label}</span>}</li>
						))}
					</ol>
				</nav>
			)
		}
		<p class="eyebrow" data-reveal>{eyebrow}</p>
		<h1 class="h1" data-split set:html={title} />
		{lead && <p class="lead" data-reveal style="--delay: 0.2s">{lead}</p>}
		<slot />
		</div>
		{hasSlot && <LiquidSlot class="slot page-hero-slot" shape={liquid} />}
	</div>
	<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
</section>

<style>
	.page-hero {
		padding-top: calc(var(--header-h) + clamp(64px, 10vw, 150px));
		padding-bottom: clamp(56px, 7vw, 110px);
	}

	.page-hero-inner {
		display: grid;
		gap: 8px;
		align-items: center;
	}

	.page-hero-copy {
		display: grid;
		gap: 24px;
		justify-items: start;
	}

	@media (min-width: 960px) {
		.has-slot .page-hero-inner {
			grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.7fr);
			gap: 48px;
		}

		.page-hero-slot {
			order: 0;
			justify-self: stretch;
			width: auto;
			height: clamp(280px, 30vw, 420px);
		}
	}

	.page-hero h1 {
		max-width: 15ch;
	}

	.page-hero .lead {
		max-width: 680px;
	}

	.breadcrumbs ol {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
		font-size: var(--fs-xs);
		color: var(--text-dim);
	}

	.breadcrumbs li + li::before {
		content: '/';
		margin-right: 6px;
		opacity: 0.6;
	}

	.breadcrumbs a {
		transition: color 0.25s ease;
	}

	.breadcrumbs a:hover {
		color: var(--text);
	}

	.breadcrumbs [aria-current] {
		color: var(--text-muted);
	}
</style>

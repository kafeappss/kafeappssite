---
import Logo from './Logo.astro';
import Wordmark from '../assets/brand/kafe-wordmark.svg';
import Icon from './Icon.astro';
import { site, whatsappLink } from '../data/site';
import { services } from '../data/services';
import { hasCases } from '../scripts/cases';

const year = new Date().getFullYear();
const whatsapp = whatsappLink();

const company = [
	{ label: 'Método', href: '/metodo' },
	...(hasCases ? [{ label: 'Cases', href: '/cases' }] : []),
	{ label: 'Sobre a Kafé', href: '/sobre' },
	{ label: 'Blog', href: '/blog' },
	{ label: 'Contato', href: '/contato' },
];

const socialIcons = {
	Instagram: 'instagram',
	LinkedIn: 'linkedin',
	YouTube: 'youtube',
	Facebook: 'facebook',
} as const;
---

<footer class="site-footer" data-liquid="pool">
	<div class="container">
		<div class="footer-grid">
			<div class="footer-brand">
				<a href="/" aria-label={`${site.name}, página inicial`}><Logo /></a>
				<p class="footer-tagline">{site.tagline}</p>
				<p class="footer-desc">
					Software house que cria aplicativos, plataformas, sistemas e soluções de IA, em código e com
					engenharia acelerada por IA.
				</p>
				<p class="footer-location"><Icon name="pin" size={18} /> {site.location.label}</p>
			</div>

			<nav class="footer-col" aria-label="Serviços">
				<h2 class="footer-title">Serviços</h2>
				<ul role="list">
					{
						services.map((service) => (
							<li>
								<a href={`/servicos/${service.slug}`}>{service.title}</a>
							</li>
						))
					}
				</ul>
			</nav>

			<nav class="footer-col" aria-label="Empresa">
				<h2 class="footer-title">Empresa</h2>
				<ul role="list">
					{
						company.map((item) => (
							<li>
								<a href={item.href}>{item.label}</a>
							</li>
						))
					}
				</ul>
			</nav>

			<div class="footer-col">
				<h2 class="footer-title">Contato</h2>
				<ul role="list">
					{
						site.contact.email && (
							<li>
								<a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
							</li>
						)
					}
					{
						whatsapp && (
							<li>
								<a href={whatsapp} target="_blank" rel="noopener">
									{site.contact.phoneDisplay || 'WhatsApp'}
								</a>
							</li>
						)
					}
					<li><a href="/contato">Formulário de contato</a></li>
				</ul>
				<ul role="list" class="footer-social">
					{
						site.social.map((social) => (
							<li>
								<a href={social.href} target="_blank" rel="noopener" aria-label={social.label}>
									<Icon name={socialIcons[social.label]} size={20} />
								</a>
							</li>
						))
					}
				</ul>
			</div>
		</div>
	</div>

	<div class="container footer-word" aria-hidden="true">
		<Wordmark />
	</div>

	<div class="container footer-bottom">
		<p class="footer-legal">
			<Logo variant="symbol" class="footer-k" />
			{[`© ${year} ${site.name}`, site.legalName, site.cnpj && `CNPJ ${site.cnpj}`].filter(Boolean).join(' · ')}
		</p>
		<p class="footer-bottom-links">
			<a href="/privacidade">Política de privacidade</a>
			<span class="footer-made">Feito com café em {site.location.city}</span>
		</p>
	</div>
</footer>

<style>
	/* Rodapé azul-marinho, arredondado e solto das bordas da tela (como o da
	   AbacatePay), logo abaixo do convite final. */
	.site-footer {
		position: relative;
		margin: 0 10px 10px;
		padding-top: clamp(72px, 9vw, 120px);
		border: 1px solid rgb(255 255 255 / 0.07);
		border-radius: 28px;
		background:
			radial-gradient(60% 50% at 100% 0%, rgb(var(--brand-rgb) / 0.22), transparent 70%),
			#0b0d1f;
		overflow: hidden;
	}

	@media (max-width: 639px) {
		.site-footer {
			margin: 0 6px 6px;
			border-radius: 22px;
		}
	}

	.footer-grid {
		display: grid;
		gap: 48px 32px;
		grid-template-columns: 1fr 1fr;
	}

	.footer-brand {
		grid-column: 1 / -1;
		display: grid;
		gap: 14px;
		max-width: 380px;
		align-content: start;
	}

	.footer-tagline {
		font-family: var(--font-display);
		font-size: 1.4rem;
		font-weight: 600;
		line-height: 1.2;
		letter-spacing: -0.035em;
		color: var(--text);
	}

	.footer-desc {
		color: var(--text-muted);
		font-size: var(--fs-small);
	}

	.footer-location {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		font-size: var(--fs-small);
		color: var(--text-muted);
	}

	.footer-title {
		margin-bottom: 18px;
		font-family: var(--font-label);
		font-size: 0.72rem;
		font-weight: 500;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--text-dim);
	}

	.footer-col ul:not(.footer-social) {
		display: grid;
		gap: 10px;
	}

	.footer-col a {
		font-size: var(--fs-small);
		color: var(--text-muted);
		transition: color 0.25s ease;
		overflow-wrap: anywhere;
	}

	.footer-col a:hover {
		color: var(--text);
	}

	.footer-social {
		display: flex;
		gap: 8px;
		margin-top: 22px;
	}

	.footer-social a {
		display: grid;
		place-items: center;
		width: 42px;
		height: 42px;
		border-radius: var(--radius-sm);
		border: 1px solid var(--line-strong);
		color: var(--text-muted);
		transition:
			color 0.25s ease,
			border-color 0.25s ease,
			transform 0.4s var(--ease-out);
	}

	.footer-social a:hover {
		color: var(--text);
		border-color: var(--accent);
		transform: translateY(-2px);
	}

	.footer-word {
		margin-top: clamp(56px, 8vw, 110px);
		margin-bottom: clamp(-120px, -6vw, -40px);
		color: rgb(var(--primary-rgb) / 0.13);
		-webkit-mask-image: linear-gradient(180deg, #000 35%, transparent 92%);
		mask-image: linear-gradient(180deg, #000 35%, transparent 92%);
		user-select: none;
		pointer-events: none;
	}

	.footer-word :global(svg) {
		width: 100%;
		height: auto;
	}

	.footer-bottom {
		position: relative;
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 12px 24px;
		padding-block: 24px 32px;
		border-top: 1px solid var(--line);
		font-size: var(--fs-xs);
		color: var(--text-dim);
	}

	.footer-legal {
		display: flex;
		align-items: center;
		gap: 12px;
	}

	.footer-legal :global(.footer-k) {
		height: 16px;
		flex: none;
	}

	.footer-bottom-links {
		display: flex;
		flex-wrap: wrap;
		gap: 8px 24px;
	}

	.footer-bottom a:hover {
		color: var(--text);
	}

	@media (min-width: 768px) {
		.footer-grid {
			grid-template-columns: 1.6fr 1fr 1fr 1fr;
		}

		.footer-brand {
			grid-column: auto;
		}
	}
</style>

---
/** O líquido e o mascote, em WebGL (ver src/scripts/liquid.ts), por cima do fundo de letras. */
---

<canvas class="liquid" aria-hidden="true" data-liquid-canvas></canvas>

<script>
	import { initLiquid } from '../scripts/liquid';

	const canvas = document.querySelector<HTMLCanvasElement>('[data-liquid-canvas]');
	if (canvas) initLiquid(canvas);
</script>

<style>
	.liquid {
		position: fixed;
		inset: 0;
		z-index: -2;
		width: 100%;
		height: 100vh;
		height: 100lvh;
		pointer-events: none;
		/* Luz estática usada enquanto o WebGL carrega (ou se ele não existir). A tela
		   é transparente: o fundo de letras (AsciiField.astro) fica atrás dela. */
		background:
			radial-gradient(60vmax 50vmax at 82% 30%, rgb(var(--brand-rgb) / 0.07), transparent 60%),
			radial-gradient(50vmax 40vmax at 10% 100%, rgb(var(--brand-rgb) / 0.05), transparent 70%);
	}

	.liquid.is-live {
		background: none;
	}
</style>

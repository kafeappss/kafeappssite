---
/** Fundo vivo do site: o metal líquido em WebGL (ver src/scripts/liquid.ts). */
---

<canvas class="liquid" aria-hidden="true" data-liquid-canvas></canvas>

<script>
	import { initLiquid } from '../scripts/liquid';

	const canvas = document.querySelector<HTMLCanvasElement>('[data-liquid-canvas]');
	if (canvas) initLiquid(canvas);
</script>

<style>
	.liquid {
		position: fixed;
		inset: 0;
		z-index: -2;
		width: 100%;
		height: 100vh;
		height: 100lvh;
		pointer-events: none;
		/* Fundo estático usado enquanto o WebGL carrega (ou se ele não existir). */
		background:
			radial-gradient(60vmax 50vmax at 82% 30%, rgb(120 120 120 / 0.16), transparent 60%),
			radial-gradient(40vmax 36vmax at 70% 78%, rgb(255 255 255 / 0.07), transparent 65%),
			radial-gradient(50vmax 40vmax at 10% 100%, rgb(70 70 70 / 0.22), transparent 70%),
			var(--bg);
	}
</style>

---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { nav, site, whatsappLink } from '../data/site';
import { services } from '../data/services';
import { hasCases } from '../scripts/cases';

const items = nav.filter((item) => item.href !== '/cases' || hasCases);

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
const whatsapp = whatsappLink();
---

<header class="site-header" data-header>
	<div class="container header-inner">
		<a href="/" class="header-logo" aria-label={`${site.name}, página inicial`}>
			<Logo />
		</a>

		<nav class="header-nav" aria-label="Principal">
			<ul role="list">
				{
					items.map((item) => (
						<li class:list={[{ 'has-menu': item.href === '/servicos' }]}>
							<a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
								{item.label}
							</a>
							{item.href === '/servicos' && (
								<div class="mega">
									<ul role="list" class="mega-list">
										{services.map((service) => (
											<li>
												<a href={`/servicos/${service.slug}`} class="mega-item">
													<span class="mega-icon">
														<Icon name={service.icon} size={22} />
													</span>
													<span>
														<strong>{service.title}</strong>
														<small>{service.short}</small>
													</span>
												</a>
											</li>
										))}
									</ul>
									<a href="/servicos" class="mega-all">
										Ver todos os serviços <Icon name="arrow" size={16} />
									</a>
								</div>
							)}
						</li>
					))
				}
			</ul>
		</nav>

		<div class="header-actions">
			<a class="btn btn-sm header-cta" href="/contato" data-mascot-look="tap">
				Fale com a gente <Icon name="arrow" class="arrow" />
			</a>
			<button
				class="menu-toggle"
				type="button"
				aria-expanded="false"
				aria-controls="menu-mobile"
				data-menu-toggle
			>
				<span class="visually-hidden" data-menu-label>Abrir menu</span>
				<span class="menu-bars" aria-hidden="true"><span></span><span></span></span>
			</button>
		</div>
	</div>

	<div class="mobile-menu" id="menu-mobile" data-menu>
		<div class="container mobile-menu-inner">
			<nav aria-label="Menu móvel">
				<ul role="list" class="mobile-links">
					<li><a href="/">Início</a></li>
					{
						items.map((item) => (
							<li>
								<a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
									{item.label}
								</a>
							</li>
						))
					}
					<li><a href="/contato">Contato</a></li>
				</ul>
			</nav>
			<div class="mobile-foot">
				<a class="btn" href={site.contact.briefUrl}>Começar meu projeto <Icon name="arrow" class="arrow" /></a>
				{
					whatsapp && (
						<a class="btn btn-ghost" href={whatsapp} target="_blank" rel="noopener">
							<Icon name="whatsapp" size={20} /> WhatsApp
						</a>
					)
				}
				<ul role="list" class="mobile-social">
					{
						site.social.map((social) => (
							<li>
								<a href={social.href} target="_blank" rel="noopener">
									{social.label}
								</a>
							</li>
						))
					}
				</ul>
			</div>
		</div>
	</div>
</header>

<script>
	const header = document.querySelector<HTMLElement>('[data-header]');
	const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
	const label = document.querySelector<HTMLElement>('[data-menu-label]');
	const menu = document.querySelector<HTMLElement>('[data-menu]');

	if (header) {
		let lastY = window.scrollY;
		let ticking = false;

		const update = () => {
			const y = window.scrollY;
			header.classList.toggle('is-scrolled', y > 12);
			const menuOpen = header.classList.contains('is-open');
			header.classList.toggle('is-hidden', !menuOpen && y > 240 && y > lastY + 4);
			if (y < lastY - 4 || y < 240) header.classList.remove('is-hidden');
			lastY = y;
			ticking = false;
		};

		window.addEventListener(
			'scroll',
			() => {
				if (!ticking) {
					ticking = true;
					requestAnimationFrame(update);
				}
			},
			{ passive: true },
		);
		header.addEventListener('focusin', () => header.classList.remove('is-hidden'));
		update();
	}

	const setMenu = (open: boolean) => {
		if (!header || !toggle || !menu) return;
		header.classList.toggle('is-open', open);
		toggle.setAttribute('aria-expanded', String(open));
		if (label) label.textContent = open ? 'Fechar menu' : 'Abrir menu';
		document.documentElement.classList.toggle('menu-open', open);
	};

	toggle?.addEventListener('click', () => setMenu(toggle.getAttribute('aria-expanded') !== 'true'));
	menu?.addEventListener('click', (event) => {
		if ((event.target as Element).closest('a')) setMenu(false);
	});
	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape') setMenu(false);
	});
	window.matchMedia('(min-width: 1024px)').addEventListener('change', (event) => {
		if (event.matches) setMenu(false);
	});
</script>

<style>
	.site-header {
		position: fixed;
		inset: 0 0 auto;
		z-index: 100;
		transition:
			transform 0.6s var(--ease-out),
			background-color 0.4s ease;
	}

	.site-header::before {
		content: '';
		position: absolute;
		inset: 0;
		background: rgb(var(--bg-rgb) / 0.62);
		border-bottom: 1px solid var(--line);
		backdrop-filter: blur(18px) saturate(1.3);
		-webkit-backdrop-filter: blur(18px) saturate(1.3);
		opacity: 0;
		transition: opacity 0.4s ease;
	}

	.site-header.is-scrolled::before {
		opacity: 1;
	}

	.site-header.is-hidden {
		transform: translateY(-100%);
	}

	.header-inner {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
		height: var(--header-h);
	}

	.header-logo {
		position: relative;
		z-index: 2;
	}

	.header-nav {
		display: none;
	}

	.header-nav > ul {
		display: flex;
		align-items: center;
		gap: 4px;
	}

	.header-nav > ul > li {
		position: relative;
	}

	.header-nav > ul > li > a {
		display: inline-flex;
		align-items: center;
		height: 40px;
		padding: 0 16px;
		border-radius: var(--radius-sm);
		font-size: 0.95rem;
		color: var(--text-muted);
		transition:
			color 0.25s ease,
			background-color 0.25s ease;
	}

	.header-nav > ul > li > a:hover,
	.header-nav > ul > li > a[aria-current='page'] {
		color: var(--text);
		background: rgb(var(--fg-rgb) / 0.06);
	}

	.has-menu > a::after {
		content: '';
		width: 6px;
		height: 6px;
		margin-left: 8px;
		border-right: 1.5px solid currentColor;
		border-bottom: 1.5px solid currentColor;
		transform: translateY(-2px) rotate(45deg);
		opacity: 0.7;
	}

	.mega {
		position: absolute;
		top: calc(100% + 14px);
		left: 50%;
		width: min(760px, 90vw);
		padding: 14px;
		border-radius: var(--radius);
		background: var(--surface);
		border: 1px solid var(--line-strong);
		box-shadow: 0 40px 80px -30px rgb(var(--bg-rgb) / 0.8);
		backdrop-filter: blur(24px);
		-webkit-backdrop-filter: blur(24px);
		opacity: 0;
		visibility: hidden;
		transform: translate(-50%, 8px);
		transition:
			opacity 0.3s ease,
			transform 0.4s var(--ease-out),
			visibility 0s linear 0.3s;
	}

	.mega::before {
		content: '';
		position: absolute;
		inset: -16px 0 auto;
		height: 16px;
	}

	.has-menu:hover .mega,
	.has-menu:focus-within .mega {
		opacity: 1;
		visibility: visible;
		transform: translate(-50%, 0);
		transition-delay: 0s;
	}

	.mega-list {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 4px;
	}

	.mega-item {
		display: flex;
		gap: 14px;
		padding: 14px;
		border-radius: var(--radius-sm);
		transition: background-color 0.25s ease;
	}

	.mega-item:hover {
		background: rgb(var(--fg-rgb) / 0.05);
	}

	.mega-icon {
		display: grid;
		place-items: center;
		width: 42px;
		height: 42px;
		flex: none;
		border-radius: var(--radius-sm);
		color: var(--text);
		background: rgb(var(--fg-rgb) / 0.06);
		border: 1px solid rgb(var(--fg-rgb) / 0.11);
	}

	.mega-item strong {
		display: block;
		font-size: 0.95rem;
		font-weight: 550;
		color: var(--text);
		letter-spacing: -0.01em;
	}

	.mega-item small {
		display: block;
		margin-top: 4px;
		font-size: 0.82rem;
		line-height: 1.45;
		color: var(--text-dim);
	}

	.mega-all {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 8px;
		margin-top: 8px;
		padding: 12px;
		border-radius: var(--radius-sm);
		font-size: 0.9rem;
		color: var(--text);
		background: rgb(var(--fg-rgb) / 0.03);
		transition: background-color 0.25s ease;
	}

	.mega-all:hover {
		background: rgb(var(--fg-rgb) / 0.07);
	}

	.header-actions {
		position: relative;
		z-index: 2;
		display: flex;
		align-items: center;
		gap: 10px;
	}

	.header-cta {
		display: none;
	}

	.menu-toggle {
		display: grid;
		place-items: center;
		width: 46px;
		height: 46px;
		border-radius: var(--radius-sm);
		border: 1px solid var(--line-strong);
		background: rgb(var(--fg-rgb) / 0.05);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
	}

	.menu-bars {
		position: relative;
		width: 18px;
		height: 10px;
	}

	.menu-bars span {
		position: absolute;
		left: 0;
		width: 100%;
		height: 1.5px;
		border-radius: 2px;
		background: var(--text);
		transition:
			transform 0.5s var(--ease-out),
			top 0.5s var(--ease-out);
	}

	.menu-bars span:first-child {
		top: 0;
	}

	.menu-bars span:last-child {
		top: calc(100% - 1.5px);
	}

	.is-open .menu-bars span:first-child {
		top: calc(50% - 0.75px);
		transform: rotate(45deg);
	}

	.is-open .menu-bars span:last-child {
		top: calc(50% - 0.75px);
		transform: rotate(-45deg);
	}

	.mobile-menu {
		position: fixed;
		inset: 0;
		z-index: 1;
		display: flex;
		padding-top: var(--header-h);
		background: var(--bg);
		backdrop-filter: blur(24px);
		-webkit-backdrop-filter: blur(24px);
		opacity: 0;
		visibility: hidden;
		transition:
			opacity 0.4s ease,
			visibility 0s linear 0.4s;
		overflow-y: auto;
	}

	.is-open .mobile-menu {
		opacity: 1;
		visibility: visible;
		transition-delay: 0s;
	}

	.mobile-menu-inner {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: 40px;
		padding-block: 32px 40px;
	}

	.mobile-links a {
		font-family: var(--font-display);
		display: block;
		padding: 10px 0;
		font-size: clamp(2rem, 9vw, 3rem);
		font-weight: 700;
		letter-spacing: -0.04em;
		line-height: 1.1;
		color: var(--text);
		opacity: 0;
		transform: translateY(16px);
		transition:
			opacity 0.5s var(--ease-out),
			transform 0.6s var(--ease-out),
			color 0.25s ease;
	}

	.mobile-links a[aria-current='page'] {
		color: var(--text);
	}

	.is-open .mobile-links a {
		opacity: 1;
		transform: none;
	}

	.is-open .mobile-links li:nth-child(2) a { transition-delay: 0.04s; }
	.is-open .mobile-links li:nth-child(3) a { transition-delay: 0.08s; }
	.is-open .mobile-links li:nth-child(4) a { transition-delay: 0.12s; }
	.is-open .mobile-links li:nth-child(5) a { transition-delay: 0.16s; }
	.is-open .mobile-links li:nth-child(6) a { transition-delay: 0.2s; }
	.is-open .mobile-links li:nth-child(7) a { transition-delay: 0.24s; }

	.mobile-foot {
		display: grid;
		gap: 12px;
	}

	.mobile-social {
		display: flex;
		flex-wrap: wrap;
		gap: 8px 20px;
		margin-top: 16px;
		font-size: 0.95rem;
		color: var(--text-muted);
	}

	:global(html.menu-open) {
		overflow: hidden;
	}

	@media (min-width: 640px) {
		.header-cta {
			display: inline-flex;
		}
	}

	@media (min-width: 1024px) {
		.header-nav {
			display: block;
		}

		.menu-toggle,
		.mobile-menu {
			display: none;
		}
	}
</style>

---
import Icon from './Icon.astro';
import { site, whatsappLink } from '../data/site';

interface Props {
	title?: string;
	lead?: string;
	/** Nome da etapa no trilho lateral. */
	rail?: string;
}

const {
	title = 'O café está passando. <em>Vamos falar da sua ideia?</em>',
	lead = 'Conte o que você quer construir. A gente responde com os próximos passos, sem compromisso e sem “tecniquês”.',
	rail,
} = Astro.props;

const whatsapp = whatsappLink();
---

<!-- O mascote descansa nos cantos enquanto o convite está na tela (data-liquid="rest"). -->
<section class="section cta" data-liquid="rest" data-rail={rail}>
	<div class="container cta-inner">
		<p class="eyebrow" data-reveal>Próximo passo</p>
		<h2 class="h1" data-split set:html={title} />
		<p class="lead" data-reveal style="--delay: 0.2s">{lead}</p>
		<div class="btn-row" data-reveal style="--delay: 0.3s">
			<a class="btn" href={whatsapp} target="_blank" rel="noopener" data-mascot-look="tap">
				<Icon name="whatsapp" size={20} /> Começar meu projeto
			</a>
		</div>
		<p class="cta-note" data-reveal style="--delay: 0.4s">
			Prefere estimar antes? Faça um <a href={site.contact.briefUrl}>pré-orçamento com a <strong>Kafeína</strong></a>.
		</p>
		<!-- Raios de luz subindo da borda de baixo do painel (src/scripts/rays.ts). -->
		<div class="cta-rays" aria-hidden="true">
			<canvas data-rays></canvas>
		</div>
	</div>
</section>

<script>
	import { initRays } from '../scripts/rays';

	document.querySelectorAll<HTMLCanvasElement>('[data-rays]').forEach((canvas) => initRays(canvas));
</script>

<style>
	/* Painel índigo, solto das bordas da tela, com os raios de luz subindo da
	   borda de baixo (como o convite final da AbacatePay). */
	.cta {
		isolation: isolate;
		overflow: hidden;
		margin: 10px;
		padding-block: clamp(96px, 11vw, 168px) 0;
		border-radius: 28px;
		background:
			radial-gradient(80% 60% at 50% 100%, rgb(167 139 250 / 0.45), transparent 70%),
			linear-gradient(180deg, #2b2d8f 0%, #4045c8 55%, #5b5fe0 100%);
	}

	.cta-inner {
		display: grid;
		justify-items: center;
		gap: 26px;
		text-align: center;
	}

	.cta h2 {
		max-width: 19ch;
		color: #fff;
	}

	.cta h2 :global(em) {
		color: rgb(255 255 255 / 0.66);
	}

	.cta .lead {
		max-width: 560px;
		color: rgb(255 255 255 / 0.82);
	}

	.cta .eyebrow {
		color: rgb(255 255 255 / 0.82);
	}

	.cta .eyebrow::before {
		background: #fff;
	}

	.cta .btn-row {
		justify-content: center;
		margin-top: 10px;
	}

	/* Botões claros sobre o índigo. */
	.cta .btn:not(.btn-ghost) {
		--btn-bg: #fff;
		--btn-fg: #1e1f6b;
	}

	.cta .btn:not(.btn-ghost)::before {
		background: #eef0ff;
	}

	.cta .btn-ghost {
		--btn-fg: #fff;
		border-color: rgb(255 255 255 / 0.35);
		background: rgb(255 255 255 / 0.08);
	}

	.cta-rays {
		position: relative;
		justify-self: stretch;
		height: clamp(220px, 26vw, 360px);
		margin-top: clamp(8px, 2vw, 24px);
		margin-inline: calc(-1 * var(--gutter));
		pointer-events: none;
	}

	.cta-rays canvas {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}

	@media (max-width: 639px) {
		.cta {
			margin: 6px;
			border-radius: 22px;
		}
	}

	.cta-note {
		font-size: var(--fs-small);
		color: rgb(255 255 255 / 0.72);
	}

	.cta-note strong {
		font-weight: 600;
		color: #fff;
	}

	.cta-note a {
		color: inherit;
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}
</style>

---
import Icon from './Icon.astro';
import Figure from './Figure.astro';
import Art from './Art.astro';
import { site, whatsappLink } from '../data/site';

interface Props {
	title?: string;
	lead?: string;
	/** Nome da etapa no trilho lateral. */
	rail?: string;
}

const {
	title = 'O café está passando. <em>Vamos falar da sua ideia?</em>',
	lead = 'Conte o que você quer construir. A gente responde com os próximos passos, sem compromisso e sem “tecniquês”.',
	rail,
} = Astro.props;

const whatsapp = whatsappLink();
---

<section
	class:list={['section cta', { 'cta-panel panel theme-dark': !site.mascot && site.theme === 'claro' }]}
	data-liquid="cup bottom"
	data-rail={rail}
>
	<div class="container cta-inner">
		<p class="eyebrow" data-reveal>Próximo passo</p>
		<h2 class="h1" data-split set:html={title} />
		<p class="lead" data-reveal style="--delay: 0.2s">{lead}</p>
		<div class="btn-row" data-reveal style="--delay: 0.3s">
			<a class="btn" href={site.contact.briefUrl} data-mascot-look="tap">Começar meu projeto <Icon name="arrow" class="arrow" /></a>
			{
				whatsapp ? (
					<a class="btn btn-ghost" href={whatsapp} target="_blank" rel="noopener" data-mascot-look="tap">
						<Icon name="whatsapp" size={20} /> Chamar no WhatsApp
					</a>
				) : (
					site.contact.email && (
						<a class="btn btn-ghost" href={`mailto:${site.contact.email}`}>
							<Icon name="mail" size={20} /> {site.contact.email}
						</a>
					)
				)
			}
		</div>
		<p class="cta-note" data-reveal style="--delay: 0.4s">
			Pré-orçamento em poucos minutos com a <strong>Kafeína</strong>, a assistente de IA da Kafé.
		</p>
		<!-- Com o mascote, o líquido desenha a xícara aqui; sem ele, aparecem os raios de
		     luz (tema claro) ou o pré-orçamento (tema escuro). -->
		{
			site.mascot ? (
				<div class="cta-cup" data-liquid-anchor aria-hidden="true" />
			) : site.theme === 'claro' ? (
				<Art kind="raios" class="cta-art" />
			) : (
				<Figure name="orcamento" class="cta-figure" />
			)
		}
	</div>
</section>

<style>
	.cta {
		padding-block: clamp(120px, 14vw, 220px) clamp(40px, 5vw, 80px);
	}

	.cta-inner {
		display: grid;
		justify-items: center;
		gap: 26px;
		text-align: center;
	}

	.cta h2 {
		max-width: 19ch;
	}

	.cta .lead {
		max-width: 560px;
	}

	.cta .btn-row {
		justify-content: center;
		margin-top: 10px;
	}

	.cta-cup {
		justify-self: stretch;
		height: clamp(150px, 18vw, 230px);
		margin-top: 12px;
	}

	/* Tema claro: um painel índigo com os raios de luz subindo da borda de
	   baixo, como o convite final da AbacatePay. */
	.cta-panel {
		isolation: isolate;
		overflow: hidden;
		margin-bottom: 10px;
		padding-bottom: 0;
		background:
			radial-gradient(80% 60% at 50% 100%, rgb(167 139 250 / 0.45), transparent 70%),
			linear-gradient(180deg, #2b2d8f 0%, #4045c8 55%, #5b5fe0 100%);
	}

	.cta-panel .cta-inner {
		position: relative;
	}

	.cta-panel h2 :global(em) {
		color: rgb(255 255 255 / 0.66);
	}

	.cta-panel .lead {
		color: rgb(255 255 255 / 0.82);
	}

	.cta-panel .eyebrow {
		color: rgb(255 255 255 / 0.82);
	}

	.cta-panel .eyebrow::before {
		background: #fff;
	}

	/* Botões claros sobre o índigo. */
	.cta-panel .btn:not(.btn-ghost) {
		--btn-bg: #fff;
		--btn-fg: #1e1f6b;
	}

	.cta-panel .btn:not(.btn-ghost)::before {
		background: #eef0ff;
	}

	.cta-panel .btn-ghost {
		--btn-fg: #fff;
		border-color: rgb(255 255 255 / 0.35);
		background: rgb(255 255 255 / 0.08);
	}

	.cta-panel .cta-note {
		color: rgb(255 255 255 / 0.72);
	}

	.cta-panel .cta-note strong {
		color: #fff;
	}

	.cta-panel :global(.cta-art) {
		justify-self: stretch;
		height: clamp(220px, 26vw, 360px);
		margin-top: clamp(8px, 2vw, 24px);
		margin-inline: calc(-1 * var(--gutter));
	}

	.cta-note {
		font-size: var(--fs-small);
		color: var(--text-dim);
	}

	.cta-note strong {
		font-weight: 600;
		color: var(--text-muted);
	}
</style>

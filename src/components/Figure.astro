---
/**
 * Tela de produto no estilo do Linear: uma janela escura, de borda fina e
 * levemente inclinada. Hoje existe só a das entregas (o "(08) Quem somos" da
 * home). É uma ilustração: fica escondida dos leitores de tela.
 */
export type FigureName = 'entregas';

interface Props {
	name: FigureName;
	class?: string;
}

const { name, class: className } = Astro.props;

// Histórico de entregas: intensidade de cada semana (determinística, sem aleatório no build).
const weeks = Array.from({ length: 26 * 7 }, (_, i) => {
	const x = Math.sin(i * 12.9898 + 78.233) * 43758.5453;
	const r = x - Math.floor(x);
	const trend = Math.floor(i / 7) / 26;
	return Math.min(4, Math.floor(r * 3 + trend * 2.6));
});
---

<div class:list={['figure', `figure-${name}`, className]} aria-hidden="true">
	{
		name === 'entregas' && (
			<div class="win">
				<div class="bar">
					<b>Entregas em produção</b>
					<span class="pill push">desde 2021</span>
				</div>
				<div class="heat">
					{weeks.map((level) => (
						<i class={`h${level}`} />
					))}
				</div>
				<div class="heat-foot">
					<span>Menos</span>
					<i class="h0" />
					<i class="h1" />
					<i class="h2" />
					<i class="h3" />
					<i class="h4" />
					<span>Mais</span>
				</div>
			</div>
		)
	}

</div>

<style>
	.figure {
		--tilt: rotateY(-9deg) rotateX(4deg);
		position: relative;
		/* Numa coluna de grid, nunca alarga a página. */
		min-width: 0;
		max-width: 100%;
		perspective: 1600px;
		font-size: 12px;
		line-height: 1.4;
		color: var(--text-secondary);
		pointer-events: none;
		user-select: none;
	}

	/* Janela: o "print" do produto, inclinado e com luz suave na borda de cima. */
	.win {
		position: relative;
		overflow: hidden;
		border: 1px solid var(--line);
		border-radius: 12px;
		background: var(--bg-level-1);
		box-shadow:
			0 40px 90px -30px rgb(0 0 0 / 0.85),
			inset 0 1px 0 rgb(255 255 255 / 0.05);
		transform: var(--tilt);
		transform-origin: 30% 50%;
		transition: transform 0.9s var(--ease-out);
	}

	@media (max-width: 959px) {
		.figure {
			--tilt: none;
		}
	}

	.bar {
		display: flex;
		align-items: center;
		gap: 8px;
		height: 38px;
		padding: 0 14px;
		border-bottom: 1px solid rgb(255 255 255 / 0.06);
		color: var(--text-tertiary);
		white-space: nowrap;
	}

	.bar b {
		color: var(--text);
		font-weight: 550;
	}

	.pill {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		padding: 2px 9px;
		border: 1px solid rgb(255 255 255 / 0.1);
		border-radius: 999px;
		font-size: 11px;
		color: var(--text-tertiary);
	}

	.push {
		margin-left: auto;
	}

	/* Entregas ----------------------------------------------------------- */
	.heat {
		display: grid;
		grid-auto-flow: column;
		grid-template-rows: repeat(7, 1fr);
		gap: 3px;
		padding: 16px 14px 10px;
	}

	.heat i,
	.heat-foot i {
		display: block;
		aspect-ratio: 1;
		border-radius: 2px;
		background: rgb(255 255 255 / 0.05);
	}

	.heat .h1,
	.heat-foot .h1 {
		background: rgb(94 106 210 / 0.3);
	}

	.heat .h2,
	.heat-foot .h2 {
		background: rgb(94 106 210 / 0.55);
	}

	.heat .h3,
	.heat-foot .h3 {
		background: rgb(113 112 255 / 0.8);
	}

	.heat .h4,
	.heat-foot .h4 {
		background: #a6aeff;
	}

	.heat-foot {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: 4px;
		padding: 0 14px 14px;
		color: var(--text-tertiary);
		font-size: 10.5px;
	}

	.heat-foot i {
		width: 10px;
	}
</style>

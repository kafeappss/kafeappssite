---
/**
 * Telas de produto no estilo do Linear: janelas escuras com bordas finas,
 * levemente inclinadas, mostrando o jeito como a Kafé trabalha (roadmap,
 * painel, revisão de código, agente de IA, sprint nas 4Ds etc.).
 * São ilustrações: ficam escondidas dos leitores de tela.
 */
import type { FigureName } from '../data/figures';

interface Props {
	name: FigureName;
	class?: string;
}

const { name, class: className } = Astro.props;

// Histórico de entregas: intensidade de cada semana (determinística, sem aleatório no build).
const weeks = Array.from({ length: 26 * 7 }, (_, i) => {
	const x = Math.sin(i * 12.9898 + 78.233) * 43758.5453;
	const r = x - Math.floor(x);
	const trend = Math.floor(i / 7) / 26;
	return Math.min(4, Math.floor(r * 3 + trend * 2.6));
});
---

<div class:list={['figure', `figure-${name}`, className]} aria-hidden="true">
	{
		name === 'prazo' && (
			<div class="win">
				<div class="bar">
					<b>Roadmap</b>
					<span class="sep">/</span>App de delivery<span class="pill push">12 semanas</span>
				</div>
				<div class="gantt">
					<div class="g-head">
						{['Sem 1', 'Sem 3', 'Sem 5', 'Sem 7', 'Sem 9', 'Sem 11'].map((label) => (
							<span>{label}</span>
						))}
					</div>
					<div class="g-row">
						<span class="g-name"><i class="st done" />Discovery</span>
						<span class="g-bar b-done" style="--s: 0; --e: 2" />
					</div>
					<div class="g-row">
						<span class="g-name"><i class="st done" />Design</span>
						<span class="g-bar b-done" style="--s: 1.5; --e: 4" />
					</div>
					<div class="g-row">
						<span class="g-name"><i class="st prog" />Develop</span>
						<span class="g-bar b-prog" style="--s: 3; --e: 8" />
					</div>
					<div class="g-row">
						<span class="g-name"><i class="st" />Deploy</span>
						<span class="g-mile" style="--s: 8">MVP no ar</span>
					</div>
					<div class="g-row">
						<span class="g-name"><i class="st" />Evolução</span>
						<span class="g-bar b-next" style="--s: 8.6; --e: 9.8" />
						<span class="g-bar b-next" style="--s: 10.2; --e: 11.4" />
					</div>
					<div class="g-row g-old">
						<span class="g-name">Modelo tradicional</span>
						<span class="g-bar b-old" style="--s: 0; --e: 12">9 meses até o primeiro feedback</span>
					</div>
					<span class="g-today" style="--s: 6.2" />
				</div>
			</div>
		)
	}

	{
		name === 'metricas' && (
			<div class="win">
				<div class="bar">
					<b>Painel</b>
					<span class="sep">/</span>Portal B2B<span class="pill push">Últimos 90 dias</span>
				</div>
				<div class="kpis">
					<div class="kpi">
						<span>Receita recorrente</span>
						<b>R$ 48,2 mil</b>
						<em class="up">+32%</em>
					</div>
					<div class="kpi">
						<span>Pedidos</span>
						<b>1.284</b>
						<em class="up">+18%</em>
					</div>
					<div class="kpi">
						<span>Tempo de resposta</span>
						<b>180 ms</b>
						<em class="up">-41%</em>
					</div>
				</div>
				<div class="chart">
					<svg viewBox="0 0 400 140" preserveAspectRatio="none">
						<defs>
							<linearGradient id="fig-area" x1="0" y1="0" x2="0" y2="1">
								<stop offset="0" stop-color="#7170ff" stop-opacity="0.28" />
								<stop offset="1" stop-color="#7170ff" stop-opacity="0" />
							</linearGradient>
						</defs>
						<g class="grid">
							<line x1="0" y1="35" x2="400" y2="35" />
							<line x1="0" y1="70" x2="400" y2="70" />
							<line x1="0" y1="105" x2="400" y2="105" />
						</g>
						<path d="M0 120 C40 116 60 110 90 104 S150 96 180 84 S240 70 270 56 S330 40 360 30 S390 22 400 18 V140 H0Z" fill="url(#fig-area)" />
						<path class="line" d="M0 120 C40 116 60 110 90 104 S150 96 180 84 S240 70 270 56 S330 40 360 30 S390 22 400 18" />
						<path class="line old" d="M0 124 C60 122 120 120 180 118 S300 112 400 108" />
					</svg>
					<div class="legend">
						<span><i class="lg new" />Com o produto novo</span>
						<span><i class="lg old" />Antes</span>
					</div>
				</div>
			</div>
		)
	}

	{
		name === 'codigo' && (
			<div class="win">
				<div class="bar">
					<span class="mono">app/checkout/pagamento.ts</span>
					<span class="pill push">
						<i class="st rev" />
						Em revisão
					</span>
				</div>
				<div class="code mono">
					<div class="ln"><span>12</span>export async function pagar(pedido: Pedido) {'{'}</div>
					<div class="ln del"><span>13</span>{'  '}const total = calcularTotal(pedido.itens)</div>
					<div class="ln add"><span>13</span>{'  '}const total = calcularTotal(pedido.itens, pedido.cupom)</div>
					<div class="ln add"><span>14</span>{'  '}if (total &lt;= 0) throw new ErroPagamento('Total inválido')</div>
					<div class="ln"><span>15</span>{'  '}return gateway.cobrar({'{'} valor: total, metodo: pedido.metodo {'}'})</div>
					<div class="ln"><span>16</span>{'}'}</div>
				</div>
				<div class="thread">
					<div class="msg">
						<span class="av ai">K</span>
						<div>
							<p class="who">
								Kafeína <span>agente de IA · 2 min</span>
							</p>
							<p>Validei o cupom antes da cobrança e escrevi 6 testes para os casos de erro.</p>
						</div>
					</div>
					<div class="msg">
						<span class="av">AN</span>
						<div>
							<p class="who">
								Ana <span>engenheira · agora</span>
							</p>
							<p>
								<i class="st done" /> Aprovado. Pode subir para produção.
							</p>
						</div>
					</div>
				</div>
			</div>
		)
	}

	{
		name === 'agente' && (
			<div class="win">
				<div class="bar">
					<span class="av ai sm">K</span>
					<b>Kafeína</b>
					<span class="pill">agente de IA</span>
					<span class="pill push">KAF-131</span>
				</div>
				<ol class="steps" role="list">
					<li>
						<i class="st done" />
						<p>Ler o pedido e os critérios de aceite</p>
						<span>12 s</span>
					</li>
					<li>
						<i class="st done" />
						<p>Escrever 14 testes para o checkout</p>
						<span>1 min</span>
					</li>
					<li>
						<i class="st done" />
						<p>Rodar a suíte: 2 falhas encontradas</p>
						<span>40 s</span>
					</li>
					<li class="now">
						<i class="st prog" />
						<p>Corrigir o tratamento de erro do Pix</p>
						<span>agora</span>
					</li>
					<li class="next">
						<i class="st" />
						<p>Revisão de um engenheiro</p>
						<span />
					</li>
				</ol>
				<div class="term mono">
					<p>
						<span class="ok">✓</span> 12 testes passaram
					</p>
					<p>
						<span class="no">✕</span> pagamento.pix › erro de tempo esgotado
					</p>
					<p>
						<span class="no">✕</span> pagamento.pix › chave inválida
					</p>
				</div>
				<div class="ask">
					Pergunte à Kafeína…<span class="send">↑</span>
				</div>
			</div>
		)
	}

	{
		name === 'sprint' && (
			<div class="win">
				<div class="bar">
					<b>Sprint 12</b>
					<span class="sep">/</span>App de delivery<span class="pill push">Metodologia 4Ds</span>
				</div>
				<div class="board">
					<div class="col">
						<h4>
							<i class="st done" />
							Discovery <span>2</span>
						</h4>
						<div class="card">
							<small>KAF-101</small>Mapear a jornada do pedido
						</div>
						<div class="card">
							<small>KAF-104</small>Priorizar o MVP
						</div>
					</div>
					<div class="col">
						<h4>
							<i class="st rev" />
							Design <span>2</span>
						</h4>
						<div class="card">
							<small>KAF-112</small>Protótipo do checkout
						</div>
						<div class="card">
							<small>KAF-118</small>Design system
						</div>
					</div>
					<div class="col">
						<h4>
							<i class="st prog" />
							Develop <span>3</span>
						</h4>
						<div class="card">
							<small>KAF-131</small>Pagamento com Pix e cartão
						</div>
						<div class="card">
							<small>KAF-136</small>Rastreio em tempo real
						</div>
						<div class="card">
							<small>KAF-140</small>Testes automatizados
						</div>
					</div>
					<div class="col">
						<h4>
							<i class="st" />
							Deploy <span>1</span>
						</h4>
						<div class="card">
							<small>KAF-150</small>Publicar nas lojas
						</div>
					</div>
				</div>
			</div>
		)
	}

	{
		name === 'entregas' && (
			<div class="win">
				<div class="bar">
					<b>Entregas em produção</b>
					<span class="pill push">desde 2021</span>
				</div>
				<div class="heat">
					{weeks.map((level) => (
						<i class={`h${level}`} />
					))}
				</div>
				<div class="heat-foot">
					<span>Menos</span>
					<i class="h0" />
					<i class="h1" />
					<i class="h2" />
					<i class="h3" />
					<i class="h4" />
					<span>Mais</span>
				</div>
			</div>
		)
	}

	{
		name === 'orcamento' && (
			<div class="win">
				<div class="bar">
					<b>Kafeína</b>
					<span class="pill">pré-orçamento</span>
					<span class="pill push">1 de 5</span>
				</div>
				<div class="chat">
					<div class="bubble">Oi! Que tipo de projeto você quer lançar?</div>
					<div class="opts">
						<span class="opt on">App mobile</span>
						<span class="opt">SaaS ou plataforma</span>
						<span class="opt">IA sob medida</span>
						<span class="opt">Sistema interno</span>
					</div>
					<div class="bubble me">App mobile</div>
					<div class="bubble">
						Ótimo. Qual problema ele resolve?
						<span class="typing">
							<i />
							<i />
							<i />
						</span>
					</div>
				</div>
			</div>
		)
	}

	{
		name === 'app' && (
			<div class="phone-wrap">
				<div class="phone">
					<div class="notch" />
					<p class="ph-eyebrow">Pedido #4821</p>
					<p class="ph-title">Saiu para entrega</p>
					<div class="map">
						<svg viewBox="0 0 200 120" preserveAspectRatio="none">
							<path class="route" d="M20 100 C60 96 70 60 100 58 S150 40 180 20" />
							<circle class="me" cx="100" cy="58" r="5" />
							<circle class="dest" cx="180" cy="20" r="4" />
						</svg>
					</div>
					<ol class="track" role="list">
						<li class="done">
							<i />
							Pedido recebido<span>19:02</span>
						</li>
						<li class="done">
							<i />
							Em preparo<span>19:05</span>
						</li>
						<li class="now">
							<i />
							Saiu para entrega<span>19:21</span>
						</li>
						<li>
							<i />
							Entregue<span>~19:34</span>
						</li>
					</ol>
					<span class="ph-btn">Falar com o entregador</span>
				</div>
			</div>
		)
	}

	{
		name === 'automacao' && (
			<div class="win">
				<div class="bar">
					<b>Automações</b>
					<span class="sep">/</span>Sistema interno<span class="pill push">4 fluxos ativos</span>
				</div>
				<div class="flows">
					{[
						['Pedido aprovado', 'NF-e emitida', 'Estoque atualizado', 'Cliente avisado'],
						['Boleto pago', 'Baixa no financeiro', 'Recibo por e-mail'],
						['Novo lead', 'Qualificado pela IA', 'CRM'],
						['Fim do mês', 'Relatório gerado', 'Enviado à diretoria'],
					].map((flow, row) => (
						<div class="flow">
							{flow.map((step, i) => (
								<>
									{i > 0 && <span class="arrow">→</span>}
									<span class:list={['node', { run: row === 2 && i === flow.length - 1 }]}>{step}</span>
								</>
							))}
							<span class="when">{['há 2 min', 'há 9 min', 'agora', 'ontem'][row]}</span>
						</div>
					))}
				</div>
			</div>
		)
	}

	{
		name === 'design' && (
			<div class="win">
				<div class="bar">
					<b>Design system</b>
					<span class="sep">/</span>App de delivery<span class="pill push">v3</span>
				</div>
				<div class="ds">
					<div class="ds-block">
						<p class="ds-label">Cores</p>
						<div class="swatches">
							<i style="background:#08090a" />
							<i style="background:#1c1c1f" />
							<i style="background:#8a8f98" />
							<i style="background:#f7f8f8" />
							<i style="background:#5e6ad2" />
						</div>
					</div>
					<div class="ds-block">
						<p class="ds-label">Tipografia</p>
						<p class="type">
							<b>Aa</b>
							<span>Título 32</span>
							<span>Texto 16</span>
						</p>
					</div>
					<div class="ds-block wide">
						<p class="ds-label">Componentes</p>
						<div class="comps">
							<span class="c-btn">Finalizar pedido</span>
							<span class="c-btn ghost">Voltar</span>
							<span class="c-input">Cupom de desconto</span>
							<span class="c-toggle">
								<i />
							</span>
						</div>
					</div>
				</div>
			</div>
		)
	}
</div>

<style>
	.figure {
		--tilt: rotateY(-9deg) rotateX(4deg);
		position: relative;
		/* Numa coluna de grid, o código sem quebra de linha não alarga a página. */
		min-width: 0;
		max-width: 100%;
		perspective: 1600px;
		font-size: 12px;
		line-height: 1.4;
		color: var(--text-secondary);
		pointer-events: none;
		user-select: none;
	}

	/* Janela: o "print" do produto, inclinado e com luz suave na borda de cima. */
	.win {
		position: relative;
		overflow: hidden;
		border: 1px solid var(--line);
		border-radius: 12px;
		background: var(--bg-level-1);
		box-shadow:
			0 40px 90px -30px rgb(0 0 0 / 0.85),
			inset 0 1px 0 rgb(255 255 255 / 0.05);
		transform: var(--tilt);
		transform-origin: 30% 50%;
		transition: transform 0.9s var(--ease-out);
	}

	@media (max-width: 959px) {
		.figure {
			--tilt: none;
		}
	}

	.bar {
		display: flex;
		align-items: center;
		gap: 8px;
		height: 38px;
		padding: 0 14px;
		border-bottom: 1px solid rgb(255 255 255 / 0.06);
		color: var(--text-tertiary);
		white-space: nowrap;
	}

	.bar b {
		color: var(--text);
		font-weight: 550;
	}

	.sep {
		color: var(--text-quaternary);
	}

	.pill {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		padding: 2px 9px;
		border: 1px solid rgb(255 255 255 / 0.1);
		border-radius: 999px;
		font-size: 11px;
		color: var(--text-tertiary);
	}

	.push {
		margin-left: auto;
	}

	.mono {
		font-family: var(--font-mono);
	}

	/* Status, como no Linear: a fazer, em andamento, em revisão e feito. */
	.st {
		display: inline-block;
		flex: none;
		width: 11px;
		height: 11px;
		border: 1.5px solid var(--text-quaternary);
		border-radius: 50%;
	}

	.st.prog {
		border-color: #f0bf00;
		background: conic-gradient(#f0bf00 0 50%, transparent 0);
	}

	.st.rev {
		border-color: #4cb782;
		background: conic-gradient(#4cb782 0 75%, transparent 0);
	}

	.st.done {
		border-color: var(--brand);
		background: var(--brand);
	}

	.av {
		display: grid;
		flex: none;
		place-items: center;
		width: 24px;
		height: 24px;
		border-radius: 50%;
		background: var(--bg-quaternary);
		color: var(--text-secondary);
		font-size: 9px;
		font-weight: 600;
		letter-spacing: 0.02em;
	}

	.av.ai {
		background: var(--primary);
		color: var(--on-primary);
		font-weight: 800;
	}

	.av.sm {
		width: 20px;
		height: 20px;
	}

	/* Roadmap ------------------------------------------------------------- */
	.gantt {
		--cols: 12;
		position: relative;
		padding: 10px 14px 16px;
	}

	.g-head,
	.g-row {
		display: grid;
		grid-template-columns: 112px 1fr;
		align-items: center;
	}

	.g-head {
		grid-template-columns: 112px repeat(6, 1fr);
		margin-bottom: 6px;
		color: var(--text-tertiary);
		font-size: 10.5px;
	}

	.g-head span:first-child {
		grid-column: 2;
	}

	.g-row {
		position: relative;
		height: 34px;
		border-top: 1px solid rgb(255 255 255 / 0.04);
	}

	.g-name {
		display: flex;
		align-items: center;
		gap: 8px;
		color: var(--text-secondary);
	}

	.g-bar,
	.g-mile {
		position: absolute;
		top: 9px;
		left: calc(112px + (100% - 112px) * var(--s) / 12);
	}

	.g-bar {
		width: calc((100% - 112px) * (var(--e) - var(--s)) / 12);
		height: 16px;
		border-radius: 5px;
	}

	.b-done {
		background: rgb(94 106 210 / 0.55);
		box-shadow: inset 0 0 0 1px rgb(130 143 255 / 0.5);
	}

	.b-prog {
		background: linear-gradient(90deg, rgb(240 191 0 / 0.5) 55%, rgb(240 191 0 / 0.14) 55%);
		box-shadow: inset 0 0 0 1px rgb(240 191 0 / 0.45);
	}

	.b-next {
		background: rgb(255 255 255 / 0.06);
		box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.12);
	}

	.g-mile {
		top: 8px;
		display: flex;
		align-items: center;
		gap: 8px;
		color: var(--text);
		font-weight: 550;
		white-space: nowrap;
		transform: translateX(-6px);
	}

	.g-mile::before {
		content: '';
		width: 11px;
		height: 11px;
		background: var(--text);
		transform: rotate(45deg);
		border-radius: 2px;
	}

	.g-old {
		margin-top: 6px;
	}

	.g-old .g-name {
		color: var(--text-tertiary);
	}

	.b-old {
		display: flex;
		align-items: center;
		padding-left: 10px;
		color: var(--text-tertiary);
		font-size: 10.5px;
		white-space: nowrap;
		background: repeating-linear-gradient(-45deg, rgb(255 255 255 / 0.05) 0 6px, transparent 6px 12px);
		box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.1);
	}

	.g-today {
		position: absolute;
		top: 34px;
		bottom: 12px;
		left: calc(14px + 112px + (100% - 28px - 112px) * var(--s) / 12);
		width: 1px;
		background: rgb(235 87 87 / 0.7);
	}

	/* Painel --------------------------------------------------------------- */
	.kpis {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		border-bottom: 1px solid rgb(255 255 255 / 0.06);
	}

	.kpi {
		display: grid;
		gap: 4px;
		padding: 14px;
	}

	.kpi + .kpi {
		border-left: 1px solid rgb(255 255 255 / 0.06);
	}

	.kpi span {
		color: var(--text-tertiary);
		font-size: 11px;
	}

	.kpi b {
		color: var(--text);
		font-size: 19px;
		font-weight: 600;
		letter-spacing: -0.01em;
	}

	.kpi em {
		font-style: normal;
		font-size: 11px;
	}

	.up {
		color: #4cb782;
	}

	.chart {
		padding: 14px;
	}

	.chart svg {
		display: block;
		width: 100%;
		height: 150px;
		overflow: visible;
	}

	.grid line {
		stroke: rgb(255 255 255 / 0.06);
		stroke-dasharray: 3 4;
	}

	.line {
		fill: none;
		stroke: #828fff;

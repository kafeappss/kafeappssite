---
/**
 * Espaço reservado para a ilustração da seção.
 * - Com o mascote ligado (site.mascot), é o lugar onde o líquido em WebGL vira a
 *   forma da seção (ver src/scripts/liquid.ts); sem WebGL, aparece o ícone.
 * - Com o mascote desligado, mostra a tela de produto equivalente (Figure.astro).
 */
import Icon from './Icon.astro';
import type { IconKey } from './Icon.astro';
import Figure from './Figure.astro';
import { figureForShape } from '../data/figures';
import { site } from '../data/site';

interface Props {
	icon?: IconKey;
	class?: string;
	/** Multiplica o tamanho da forma dentro do espaço. */
	scale?: number;
	iconSize?: number;
	/** Forma da seção (ex.: "clock"): define a tela de produto quando o mascote está desligado. */
	shape?: string;
}

const { icon, class: className, scale, iconSize = 44, shape, ...rest } = Astro.props;
const figure = !site.mascot && shape ? figureForShape[shape] : undefined;
---

{
	figure ? (
		<Figure name={figure} class={['figure-slot', className].filter(Boolean).join(' ')} />
	) : site.mascot ? (
		<div class:list={['liquid-slot', className]} data-liquid-anchor={scale ? String(scale) : ''} aria-hidden="true" {...rest}>
			{icon && <Icon name={icon} size={iconSize} class="liquid-slot-icon" />}
		</div>
	) : null
}

<style>
	.liquid-slot {
		position: relative;
		display: grid;
		place-items: center;
		pointer-events: none;
	}

	.liquid-slot :global(.liquid-slot-icon) {
		color: var(--text-dim);
		opacity: 0.6;
		transition:
			opacity 0.5s ease,
			transform 0.6s var(--ease-out);
	}

	:global(html.liquid-live) .liquid-slot :global(.liquid-slot-icon) {
		opacity: 0;
		transform: scale(0.8);
	}
</style>

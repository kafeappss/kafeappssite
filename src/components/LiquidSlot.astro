---
/**
 * Espaço reservado para o metal líquido (ver src/scripts/liquid.ts): quando a
 * seção está em foco, a forma dela mora aqui e rola junto com o conteúdo.
 * Sem WebGL (ou antes de ele carregar), aparece o ícone no lugar.
 */
import Icon from './Icon.astro';
import type { IconKey } from './Icon.astro';

interface Props {
	icon?: IconKey;
	class?: string;
	/** Multiplica o tamanho da forma dentro do espaço. */
	scale?: number;
	iconSize?: number;
}

const { icon, class: className, scale, iconSize = 44, ...rest } = Astro.props;
---

<div class:list={['liquid-slot', className]} data-liquid-anchor={scale ? String(scale) : ''} aria-hidden="true" {...rest}>
	{icon && <Icon name={icon} size={iconSize} class="liquid-slot-icon" />}
</div>

<style>
	.liquid-slot {
		position: relative;
		display: grid;
		place-items: center;
		pointer-events: none;
	}

	.liquid-slot :global(.liquid-slot-icon) {
		color: var(--text-dim);
		opacity: 0.6;
		transition:
			opacity 0.5s ease,
			transform 0.6s var(--ease-out);
	}

	:global(html.liquid-live) .liquid-slot :global(.liquid-slot-icon) {
		opacity: 0;
		transform: scale(0.8);
	}
</style>

---
/**
 * Imagem conceitual animada, desenhada em canvas (ver src/scripts/art.ts).
 * Decorativa: fica escondida dos leitores de tela.
 */
import type { ArtKind } from '../data/figures';

interface Props {
	kind: ArtKind;
	class?: string;
}

const { kind, class: className } = Astro.props;
---

<div class:list={['art', `art-${kind}`, className]} aria-hidden="true">
	<canvas data-art={kind}></canvas>
</div>

<script>
	import { initArt } from '../scripts/art';

	document.querySelectorAll<HTMLCanvasElement>('canvas[data-art]').forEach((canvas) => initArt(canvas));
</script>

<style>
	.art {
		position: relative;
		min-width: 0;
		pointer-events: none;
	}

	.art canvas {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}
</style>

---
import Wordmark from '../assets/brand/kafe-wordmark.svg';
import Symbol from '../assets/brand/kafe-k.svg';

interface Props {
	class?: string;
	/** "wordmark": KAFÉ APPS empilhado; "symbol": só o K. */
	variant?: 'wordmark' | 'symbol';
}

const { class: className, variant = 'wordmark' } = Astro.props;
---

<span class:list={['logo', `logo-${variant}`, className]}>
	{variant === 'symbol' ? <Symbol aria-hidden="true" /> : <Wordmark aria-hidden="true" />}
</span>

<style>
	.logo {
		display: inline-flex;
		color: var(--text);
		line-height: 0;
	}

	.logo :global(svg) {
		width: auto;
		height: 100%;
	}

	.logo-wordmark {
		height: 34px;
	}

	.logo-symbol {
		height: 30px;
	}
</style>

---
/**
 * Camada interativa do mascote. A gota em si é desenhada pelo WebGL
 * (formação "mascot"); aqui ficam o botão acessível e o balão de fala.
 */
---

<button class="mascot-hit" type="button" data-mascot-hit aria-label="Mascote da Kafé: clique para ele falar"
></button>
<div class="mascot-bubble" data-mascot-bubble aria-live="polite">
	<p class="mascot-bubble-inner" data-mascot-text></p>
</div>

<script>
	import '../scripts/mascot';
</script>

<style>
	.mascot-hit {
		position: fixed;
		top: 0;
		left: 0;
		z-index: 5;
		border-radius: 50%;
		cursor: pointer;
		visibility: hidden;
		pointer-events: none;
	}

	.mascot-hit[data-visible='true'] {
		visibility: visible;
		pointer-events: auto;
	}

	.mascot-hit:focus-visible {
		outline: 1px dashed rgb(255 255 255 / 0.6);
		outline-offset: 6px;
	}

	.mascot-bubble {
		position: fixed;
		top: 0;
		left: 0;
		z-index: 6;
		pointer-events: none;
		visibility: hidden;
	}

	.mascot-bubble[data-visible='true'] {
		visibility: visible;
	}

	.mascot-bubble-inner {
		position: absolute;
		right: 0;
		bottom: 0;
		width: max-content;
		max-width: min(280px, 70vw);
		padding: 12px 16px;
		border-radius: var(--radius-sm);
		background: var(--white);
		color: var(--black);
		font-size: 0.92rem;
		font-weight: 600;
		line-height: 1.35;
		letter-spacing: -0.01em;
		box-shadow: 0 18px 40px -12px rgb(0 0 0 / 0.7);
		opacity: 0;
		transform: translateY(8px) scale(0.96);
		transform-origin: bottom right;
		transition:
			opacity 0.3s ease,
			transform 0.45s var(--ease-out);
	}

	@media (max-width: 639px) {
		.mascot-bubble-inner {
			max-width: 50vw;
			font-size: 0.86rem;
		}
	}

	.mascot-bubble-inner::after {
		content: '';
		position: absolute;
		right: 22px;
		bottom: -7px;
		width: 14px;
		height: 14px;
		background: var(--white);
		transform: rotate(45deg);
	}

	.is-talking .mascot-bubble-inner {
		opacity: 1;
		transform: none;
	}
</style>

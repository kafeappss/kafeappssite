---
/**
 * Ícones de traço desenhados para o site (24×24, herdam a cor do texto).
 */
const icons = {
	arrow: '<path d="M5 12h14M13 6l6 6-6 6"/>',
	'arrow-up-right': '<path d="M7 17 17 7M8.5 7H17v8.5"/>',
	phone: '<rect x="6.5" y="2.5" width="11" height="19" rx="2.8"/><path d="M10.5 18.5h3"/>',
	rocket:
		'<path d="M12 2.8c3.1 2.1 4.6 5.6 4.6 9.6l-2.1 3.6h-5l-2.1-3.6c0-4 1.5-7.5 4.6-9.6Z"/><circle cx="12" cy="9.6" r="1.7"/><path d="m9.4 15.6-2.6 3.1 2.8.5M14.6 15.6l2.6 3.1-2.8.5M12 18.4v3"/>',
	blocks:
		'<rect x="3.5" y="13.5" width="7" height="7" rx="1.6"/><rect x="13.5" y="13.5" width="7" height="7" rx="1.6"/><rect x="3.5" y="3.5" width="7" height="7" rx="1.6"/><path d="m17 2.9 4.1 4.1-4.1 4.1L12.9 7Z"/>',
	browser:
		'<rect x="2.5" y="4" width="19" height="16" rx="2.6"/><path d="M2.5 9h19"/><circle cx="5.7" cy="6.5" r=".5" fill="currentColor"/><circle cx="7.9" cy="6.5" r=".5" fill="currentColor"/><path d="M7 14h6M7 16.6h3.5"/>',
	gear:
		'<circle cx="6" cy="6" r="2.6"/><circle cx="18" cy="6" r="2.6"/><circle cx="12" cy="18" r="2.6"/><path d="M8.6 6h6.8M7.3 8.3l3.4 7.4M16.7 8.3l-3.4 7.4"/>',
	pen: '<path d="m4 20 4.6-1.2L19.1 8.3a2.1 2.1 0 0 0-3-3L5.4 15.8Z"/><path d="m14.4 7 2.6 2.6M4 20h7"/>',
	check: '<path d="m5 12.5 4.5 4.5L19 7.5"/>',
	plus: '<path d="M12 5v14M5 12h14"/>',
	minus: '<path d="M5 12h14"/>',
	menu: '<path d="M4 8.5h16M4 15.5h16"/>',
	close: '<path d="m6 6 12 12M18 6 6 18"/>',
	mail: '<rect x="3" y="5" width="18" height="14" rx="2.6"/><path d="m3.6 7.2 8.4 6 8.4-6"/>',
	pin: '<path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 1 1 13 0c0 5.4-6.5 11-6.5 11Z"/><circle cx="12" cy="10" r="2.3"/>',
	whatsapp:
		'<path d="M12 3.2a8.8 8.8 0 0 0-7.6 13.2L3.2 20.8l4.5-1.2A8.8 8.8 0 1 0 12 3.2Z"/><path d="M9.1 8.2c.2-.4.5-.4.8-.4h.5c.2 0 .4.1.5.4l.7 1.7c.1.2 0 .5-.1.6l-.5.6c-.1.2-.1.4 0 .6.7 1.2 1.6 2 2.8 2.6.2.1.4.1.6-.1l.6-.7c.2-.2.4-.2.6-.1l1.6.8c.2.1.3.3.3.5 0 .9-.6 1.8-1.6 2-1 .2-2.3-.1-3.9-1.1a9.6 9.6 0 0 1-3.3-3.6c-.8-1.5-.8-2.9-.6-3.8Z" fill="currentColor" stroke="none"/>',
	instagram:
		'<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.3" cy="6.7" r=".9" fill="currentColor" stroke="none"/>',
	linkedin:
		'<rect x="3" y="3" width="18" height="18" rx="3.2"/><path d="M8 10.5v6M8 7.5v.2M12 16.5v-3.4a2.5 2.5 0 0 1 5 0v3.4M12 10.5v6"/>',
	youtube:
		'<rect x="2.5" y="5.5" width="19" height="13" rx="4"/><path d="m10.4 9.4 4.6 2.6-4.6 2.6Z" fill="currentColor"/>',
	facebook:
		'<path d="M14.2 21v-7h2.4l.4-3h-2.8V9.2c0-.9.3-1.4 1.5-1.4H17V5.2a19 19 0 0 0-2.2-.1c-2.2 0-3.7 1.3-3.7 3.8V11H8.7v3h2.4v7"/>',
	sparkle: '<path d="M12 3c.6 4.6 3.4 7.4 8 8-4.6.6-7.4 3.4-8 8-.6-4.6-3.4-7.4-8-8 4.6-.6 7.4-3.4 8-8Z" fill="currentColor" stroke="none"/>',
	bean: '<g transform="rotate(-32 12 12)"><ellipse cx="12" cy="12" rx="6.6" ry="9.4"/><path d="M12.4 2.8c-2.6 3-2.6 6.2-.3 9.2s2.3 6.2-.3 9.2"/></g>',
	clock: '<circle cx="12" cy="12" r="8.6"/><path d="M12 7.5V12l3 2"/>',
	chat: '<path d="M20 15.2a2.3 2.3 0 0 1-2.3 2.3H9l-4.5 3.5v-3.5h-.2A2.3 2.3 0 0 1 2 15.2V6.3A2.3 2.3 0 0 1 4.3 4h13.4A2.3 2.3 0 0 1 20 6.3Z"/>',
} as const;

export type IconKey = keyof typeof icons;

interface Props {
	name: IconKey;
	class?: string;
	size?: number;
	label?: string;
}

const { name, class: className, size = 24, label } = Astro.props;
---

<svg
	class:list={['icon', className]}
	width={size}
	height={size}
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="1.6"
	stroke-linecap="round"
	stroke-linejoin="round"
	role={label ? 'img' : undefined}
	aria-label={label}
	aria-hidden={label ? undefined : 'true'}
	set:html={icons[name]}
/>

---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import Marquee from '../components/Marquee.astro';
import Mascot from '../components/Mascot.astro';
import LiquidSlot from '../components/LiquidSlot.astro';
import Figure from '../components/Figure.astro';
import MethodSteps from '../components/MethodSteps.astro';
import ToolsOrbit from '../components/ToolsOrbit.astro';
import Testimonials from '../components/Testimonials.astro';
import Clients from '../components/Clients.astro';
import BlogCard from '../components/BlogCard.astro';
import Faq from '../components/Faq.astro';
import CtaSection from '../components/CtaSection.astro';
import Icon from '../components/Icon.astro';
import { services } from '../data/services';
import { aiPillars, engagementModels, faq } from '../data/method';
import { differentials, productTypes, site, stats, technologies } from '../data/site';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
	.sort((a, b) => b.data.date.getTime() - a.data.date.getTime() || a.data.title.localeCompare(b.data.title))
	.slice(0, 3);

const pains = [
	{
		title: 'Meses até o primeiro feedback',
		description:
			'Projetos longos demais adiam a única coisa que importa no começo: descobrir se alguém quer o que você está construindo.',
	},
	{
		title: 'Orçamento no lugar errado',
		description:
			'Funcionalidades “essenciais” que ninguém usa consomem o dinheiro que deveria financiar o crescimento.',
	},
	{
		title: 'Time caro, cedo demais',
		description: 'Montar uma equipe técnica completa antes de validar o negócio aumenta o risco e o custo fixo.',
	},
];

const stages = [
	{
		name: 'Validar',
		from: 'Do guardanapo ao MVP',
		description: 'Descobrimos o que precisa ser provado e colocamos no ar a menor versão capaz de provar.',
	},
	{
		name: 'Lançar',
		from: 'Do MVP ao mercado',
		description: 'Produto publicado, métricas configuradas e usuários reais gerando aprendizado todos os dias.',
	},
	{
		name: 'Escalar',
		from: 'Do mercado ao crescimento',
		description: 'Evolução contínua, novas funcionalidades e arquitetura preparada para crescer com você.',
	},
];

/** Tamanho de cada serviço no mosaico (em colunas de uma grade de 6). */
const spans = ['span-3', 'span-3', 'span-2', 'span-2', 'span-2', 'span-4'];

const capabilities = [
	'Aplicativos iOS e Android',
	'Plataformas SaaS',
	'Agentes de IA',
	'MVPs para startups',
	'Sistemas sob medida',
	'Integrações e APIs',
	'Automação com IA',
	'UX Research',
	'UI Design',
	'Painéis de dados',
];
---

<Base
	description="A Kafé Apps cria aplicativos, plataformas, sistemas e soluções de IA sob medida, em código e com engenharia acelerada por IA. Software house de Jaraguá do Sul (SC) que atende todo o Brasil."
>
	<!-- Início: o mascote (no celular, como no Zirtuno: título curto, mascote grande e "Diga oi") -->
	<section class:list={['hero', { 'hero-solo': !site.mascot }]} data-liquid="mascot" data-rail="Início" data-horizon data-ascii-strong>
		<div class="container hero-inner">
			<div class="hero-copy">
				<p class="eyebrow" data-reveal>Seu time de engenharia, de {site.location.state} para o Brasil</p>
				<h1 class="display hero-title" data-split>Mais negócio, <em>menos software.</em></h1>
				<p class="lead hero-lead" data-reveal style="--delay: 0.35s">
					A Kafé Apps cria aplicativos, plataformas, sistemas e soluções de IA sob medida, em código e com
					engenheiros acelerados por inteligência artificial.{' '}
					<span class="hero-lead-more">Do MVP ao produto em escala, sem desperdício.</span>
				</p>
				<div class="btn-row" data-reveal style="--delay: 0.5s">
					<a class="btn" href={site.contact.briefUrl} data-mascot-look="nod">
						Tirar minha ideia do papel <Icon name="arrow" class="arrow" />
					</a>
					<a class="btn btn-ghost" href="#servicos" data-mascot-look="look">Ver o que fazemos</a>
				</div>
				<ul role="list" class="hero-proof" data-reveal style="--delay: 0.65s">
					<li><Icon name="clock" size={18} /> Desde {site.foundingYear}</li>
					<li data-mascot-look="star"><Icon name="spark" size={18} /> Engenharia aumentada por IA</li>
					<li><Icon name="k" size={18} /> Metodologia 4Ds</li>
				</ul>
			</div>
			<!-- Mascote: ao lado do texto no computador, logo abaixo do título no celular. -->
			{
				site.mascot && (
					<div class="hero-stage" data-horizon-anchor>
						<div class="hero-mascot" data-liquid-anchor aria-hidden="true" />
						<button class="talk-pill" type="button" data-mascot-talk>
							<span class="talk-eyes" aria-hidden="true">
								<i />
								<i />
							</span>
							<span class="talk-label" data-mascot-label aria-live="polite">
								Diga oi
							</span>
						</button>
					</div>
				)
			}
		</div>
		{site.mascot && <Mascot />}
	</section>

	<Marquee items={capabilities} />

	<!-- 01 · Problema: o relógio -->
	<section class="section" id="problema" data-liquid="clock" data-rail="Problema">
		<div class="container">
			<div class="head-split">
				<SectionHead
					eyebrow="O problema"
					title="Boas ideias raramente morrem por serem ruins. <em>Morrem por demorar.</em>"
					lead="Meses de desenvolvimento antes do primeiro usuário, orçamento consumido por funcionalidades que ninguém pediu e um time caro antes de o negócio provar que funciona. Existe outro caminho."
				/>
				<LiquidSlot class="slot" icon="clock" shape="clock" />
			</div>
			<ol role="list" class="pains">
				{
					pains.map((pain, index) => (
						<li class="card pain" data-reveal style={`--delay: ${index * 0.1}s`}>
							<span class="pain-num label">0{index + 1}</span>
							<h3 class="h3">{pain.title}</h3>
							<p>{pain.description}</p>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<!-- 02 · Virada: as barras de crescimento -->
	<section class="section tone-band" data-liquid="bars" data-rail="Virada">
		<div class="container turn">
			<LiquidSlot class="slot turn-slot" shape="bars" />
			<SectionHead
				eyebrow="A virada"
				title="Primeiro o negócio. <em>Depois o software.</em>"
				lead="Entendemos o negócio antes de escolher a tecnologia. Cada linha de código precisa ter um motivo para existir e um resultado para entregar."
				center
			/>
			<ol role="list" class="stages">
				{
					stages.map((stage, index) => (
						<li class="stage" data-reveal style={`--delay: ${index * 0.12}s`}>
							<span class="stage-from label">{stage.from}</span>
							<p class="stage-name">{stage.name}</p>
							<p class="stage-desc">{stage.description}</p>
							{index < stages.length - 1 && (
								<span class="stage-arrow" aria-hidden="true">
									<Icon name="arrow" size={22} />
								</span>
							)}
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<!-- 03 · Serviços: passe o mouse e o líquido vira cada serviço -->
	<section class="section services" id="servicos" data-liquid="code" data-rail="Serviços">
		<div class="container">
			<div class="head-split">
				<SectionHead
					eyebrow="O que fazemos"
					title="Do aplicativo à IA, <em>tudo em código.</em>"
					lead="Seis frentes, um só time: estratégia, design, engenharia e inteligência artificial trabalhando juntos, do primeiro rascunho à evolução contínua."
				/>
				<LiquidSlot class="slot" shape="code" />
			</div>
			<div class="bento">
				{
					services.map((service, index) => (
						<a
							href={`/servicos/${service.slug}`}
							class:list={['svc', spans[index]]}
							data-liquid-hover={service.shape}
							data-reveal
							style={`--delay: ${(index % 3) * 0.08}s`}
						>
							<div class="svc-top">
								<span class="svc-num label">{String(index + 1).padStart(2, '0')}</span>
								<span class="svc-slot" data-liquid-anchor aria-hidden="true">
									<Icon name={service.icon} size={40} class="svc-icon" />
								</span>
							</div>
							<h3 class="svc-title">{service.title}</h3>
							<p class="svc-text">{service.short}</p>
							<ul role="list" class="svc-tags">
								{service.keywords.map((keyword) => (
									<li class="tag">{keyword}</li>
								))}
							</ul>
							<span class="svc-more">
								Ver detalhes <Icon name="arrow-up-right" size={18} />
							</span>
						</a>
					))
				}
				<a href={site.contact.briefUrl} class="svc svc-cta span-2" data-reveal style="--delay: 0.16s">
					<span class="svc-num label">Não sabe por onde começar?</span>
					<p class="svc-title">Monte um pré-orçamento com a Kafeína, nossa IA.</p>
					<span class="svc-more">
						Começar agora <Icon name="arrow" size={18} />
					</span>
				</a>
			</div>
		</div>
	</section>

	<!-- 04 · O que dá para construir -->
	<section class="section tone-brand" data-liquid="rest">
		<div class="container">
			<SectionHead eyebrow="O que dá para construir" title="Do delivery ao SaaS, <em>sua ideia tem lugar aqui.</em>" />
			<ul role="list" class="types" data-reveal>
				{
					productTypes.map((type) => (
						<li>
							<span>{type}</span>
							<Icon name="k" size={16} class="types-mark" />
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<!-- 05 · Engenharia aumentada por IA: código + faísca -->
	<section class="section tone-glass" id="ia" data-liquid="code-ai" data-rail="IA">
		<div class="container ia">
			{
				site.mascot && (
					<div class="ia-stage">
						<LiquidSlot class="slot ia-slot" icon="spark" shape="code-ai" />
					</div>
				)
			}
			<div class="ia-copy">
				<SectionHead
					eyebrow="Engenharia aumentada por IA"
					title="Código escrito por pessoas. <span data-pulse><em>Acelerado por IA.</em></span>"
					lead="Nossos engenheiros trabalham lado a lado com agentes de IA. A IA cuida do trabalho repetitivo; as pessoas cuidam das decisões, da arquitetura e da qualidade. Você recebe software sob medida, mais rápido."
				/>
				<ul role="list" class="pillars">
					{
						aiPillars.map((pillar, index) => (
							<li data-reveal style={`--delay: ${index * 0.06}s`}>
								<span class="pillar-num label">0{index + 1}</span>
								<h3>{pillar.title}</h3>
								<p>{pillar.description}</p>
							</li>
						))
					}
				</ul>
				{
					technologies.length > 0 && (
						<div class="tools" data-reveal>
							<p class="label">Ferramentas do dia a dia</p>
							<ToolsOrbit />
						</div>
					)
				}
			</div>
		</div>
	</section>

	<!-- 06 · Metodologia 4Ds: o ciclo (cada etapa gira o ciclo) -->
	<section class="section" id="metodo" data-liquid="cycle-0" data-rail="Método">
		<div class="container">
			<div class="head-split">
				<SectionHead
					eyebrow="Metodologia 4Ds"
					title="Quatro etapas. <em>Nenhuma surpresa.</em>"
					lead="Nossa metodologia própria combina design inteligente, engenharia acelerada por IA e processos ágeis. Você acompanha cada etapa em tempo real."
				/>
				<LiquidSlot class="slot" shape="cycle-0" />
			</div>
			<MethodSteps liquid />
		</div>

		<div class="container models" data-liquid="rest">
			<div class="head-row">
				<p class="eyebrow" data-reveal>Formatos de trabalho</p>
				<a class="link-arrow" href="/metodo" data-reveal>Ver o método completo <Icon name="arrow" /></a>
			</div>
			<div class="models-grid">
				{
					engagementModels.map((model, index) => (
						<article class="card model" data-reveal style={`--delay: ${index * 0.08}s`}>
							<span class="tag">{model.badge}</span>
							<h3 class="h3">{model.name}</h3>
							<p>{model.description}</p>
							<ul role="list">
								{model.items.map((item) => (
									<li>
										<Icon name="check" size={16} />
										{item}
									</li>
								))}
							</ul>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<!-- 07 · Clientes -->
	<section class="section" id="clientes" data-liquid="rest" data-rail="Clientes">
		<div class="container">
			<SectionHead
				eyebrow="Quem confia"
				title="Empresas que resolveram problemas reais <em>com a Kafé.</em>"
			/>
			<Clients />
			<div class="testimonials-wrap">
				<Testimonials />
			</div>
		</div>
	</section>

	<!-- 08 · Quem somos: o K -->
	<section class="section" id="sobre" data-liquid="rest" data-rail="Sobre">
		<div class="container soul">
			<div class="soul-text">
				<SectionHead
					eyebrow="Quem somos"
					title="Somos de Jaraguá do Sul e vivemos de <em>tirar ideias do papel.</em>"
				/>
				<div class="soul-copy" data-reveal>
					<p>
						A Kafé Apps nasceu em {site.foundingYear} com a missão de democratizar a criação de novos negócios e a
						geração de empregos por meio de tecnologias ágeis. Hoje, unimos engenharia de software e inteligência
						artificial para ajudar startups e empresas a validar ideias, lançar produtos e crescer.
					</p>
					<p class="soul-quote">
						Toda boa ideia já começou numa conversa de café. Nosso trabalho é garantir que ela não termine ali.
					</p>
					<a class="link-arrow" href="/sobre">Conheça a Kafé <Icon name="arrow" /></a>
				</div>
			</div>
			<div class="soul-bento">
				<div class="k-tile">
					<Figure name="entregas" class="figure-slot k-slot" />
					<span class="k-caption label">Kafé Apps · desde {site.foundingYear}</span>
				</div>
				<dl class="stats">
					{
						stats.map((stat, index) => (
							<div class="stat" data-reveal style={`--delay: ${index * 0.06}s`}>
								<dt>{stat.label}</dt>
								<dd>{stat.value}</dd>
							</div>
						))
					}
				</dl>
			</div>
		</div>

		<div class="container" data-liquid="rest">
			<ul role="list" class="diffs">
				{
					differentials.map((item, index) => (
						<li class="diff" data-reveal style={`--delay: ${(index % 3) * 0.06}s`}>
							<Icon name="check" size={20} class="diff-icon" />
							<div>
								<h3>{item.title}</h3>
								<p>{item.description}</p>
							</div>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	{
		posts.length > 0 && (
			<section class="section tone-band" data-liquid="rest">
				<div class="container">
					<div class="head-row">
						<SectionHead
							eyebrow="Conteúdo"
							title="Ideias para quem <em>constrói produtos.</em>"
							lead="Artigos sobre produto, tecnologia e IA, além do PodKafé, nosso podcast no YouTube."
						/>
						<div class="head-actions" data-reveal>
							<a class="btn btn-ghost btn-sm" href="/blog">
								Ver todos os artigos
							</a>
						</div>
					</div>
					<div class="posts-grid">
						{posts.map((post, index) => (
							<BlogCard post={post} index={index} />
						))}
					</div>
				</div>
			</section>
		)
	}

	<section class="section" data-liquid="rest" data-rail="Dúvidas">
		<div class="container faq-layout">
			<SectionHead
				eyebrow="Perguntas frequentes"
				title="O que sempre aparece <em>no primeiro café.</em>"
				lead="Não achou sua dúvida? Mande uma mensagem. A gente responde rapidinho."
			>
				<div data-reveal style="--delay: 0.25s">
					<a class="link-arrow" href="/contato">Falar com a Kafé <Icon name="arrow" /></a>
				</div>
			</SectionHead>
			<Faq items={faq} />
		</div>
	</section>

	<CtaSection rail="Contato" />
</Base>

<style>
	/* Início ------------------------------------------------------------------ */
	.hero {
		position: relative;
		display: flex;
		align-items: center;
		min-height: 100vh;
		min-height: 100svh;
		padding-top: calc(var(--header-h) + 40px);
		padding-bottom: 120px;
	}

	.hero-inner {
		display: grid;
		gap: 28px;
	}

	.hero-copy {
		display: grid;
		gap: 28px;
		justify-items: start;
	}

	.hero-title {
		max-width: 13ch;
	}

	.hero-lead {
		max-width: 580px;
	}

	.hero .btn-row {
		margin-top: 8px;
	}

	.hero-proof {
		display: flex;
		flex-wrap: wrap;
		gap: 10px 26px;
		margin-top: 18px;
		font-size: var(--fs-small);
		color: var(--text-muted);
	}

	.hero-proof li {
		display: inline-flex;
		align-items: center;
		gap: 8px;
	}

	.hero-proof :global(svg) {
		color: var(--accent);
	}

	.hero-stage {
		display: grid;
		justify-items: center;
		gap: 6px;
	}

	.hero-mascot {
		justify-self: stretch;
		min-height: 220px;
	}



	/* Tela larga: mascote ao lado do texto, com o "Diga oi" embaixo. */
	@media (min-width: 960px) and (min-aspect-ratio: 9/10) {
		.hero-inner:has(.hero-stage) {
			grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.7fr);
			align-items: center;
			gap: 24px;
		}

		/* Como no Zirtuno: o mascote fica baixo, com a parte de baixo mergulhada na
		   onda de luz do fim da abertura, e o "Diga oi" vai para cima da onda. */
		.hero-stage {
			position: relative;
			align-self: stretch;
		}

		.hero-mascot {
			position: absolute;
			right: 0;
			bottom: calc(-1 * clamp(120px, 17vh, 190px));
			left: 0;
			height: clamp(360px, 56vh, 600px);
		}

		.hero-stage .talk-pill {
			position: absolute;
			right: 0;
			bottom: calc(-1 * clamp(96px, 13vh, 150px));
		}

	}

	/*
	 * Tela em pé (celular): primeira tela só com o título e o mascote grande,
	 * como no Zirtuno. O texto, os botões e os números vêm logo abaixo.
	 */
	@media (max-aspect-ratio: 9/10) {
		.hero {
			align-items: stretch;
			padding-top: calc(var(--header-h) + 22px);
			padding-bottom: 40px;
		}

		.hero-inner {
			display: flex;
			flex-direction: column;
			gap: 20px;
		}

		.hero-copy {
			display: contents;
		}

		.hero .eyebrow::before {
			display: none;
		}

		.hero .eyebrow {
			order: 1;
			align-self: center;
			max-width: 30ch;
			text-align: center;
			line-height: 1.7;
		}

		.hero-title {
			order: 2;
			align-self: center;
			text-align: center;
		}

		.hero-stage {
			position: relative;
			order: 3;
			height: clamp(330px, 52svh, 500px);
			margin-inline: calc(-1 * var(--gutter));
			/* A âncora do mascote passa da tela; sem isto, o celular afasta o zoom. */
			overflow-x: clip;
		}

		/* O espaço é mais largo que a tela: o mascote fica grande. */
		.hero-mascot {
			position: absolute;
			inset: 0 -14% 62px;
			min-height: 0;
		}

		.talk-pill {
			position: absolute;
			bottom: 8px;
			left: 50%;
			transform: translateX(-50%);
		}

		.talk-pill:active {
			transform: translateX(-50%) scale(0.96);
		}

		.hero-lead {
			order: 4;
			margin-top: 12px;
			text-align: center;
		}

		.hero .btn-row {
			order: 5;
			flex-direction: column;
			align-self: stretch;
		}

		.hero .btn-row :global(.btn) {
			width: 100%;
		}

		.hero-proof {
			order: 6;
			justify-content: center;
		}

		/*
		 * Sem o mascote: a abertura fica só do tamanho do conteúdo (o começo da
		 * próxima parte aparece embaixo e convida a rolar), com menos texto: só a
		 * primeira frase do texto de apoio.
		 */
		.hero-solo {
			min-height: auto;
			padding-top: calc(var(--header-h) + 28px);
			padding-bottom: 40px;
		}

		.hero-solo .hero-inner {
			gap: 14px;
		}

		.hero-solo .hero-lead {
			margin-top: 2px;
		}

		.hero-solo .hero-lead-more {
			display: none;
		}

		/* Os selos, mais juntinhos, logo abaixo dos botões. */
		.hero-solo .hero-proof {
			gap: 8px 18px;
			margin-top: 4px;
			font-size: var(--fs-xs);
		}
	}

	/* Celular baixinho: menos respiro, para a próxima parte ainda aparecer. */
	@media (max-aspect-ratio: 9/10) and (max-height: 720px) {
		.hero-solo {
			padding-top: calc(var(--header-h) + 12px);
			padding-bottom: 26px;
		}

		.hero-solo .hero-title {
			font-size: 2.75rem;
		}
	}

	/* 01 · Problema ------------------------------------------------------------ */
	.pains {
		display: grid;

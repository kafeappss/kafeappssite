---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import Marquee from '../components/Marquee.astro';
import Mascot from '../components/Mascot.astro';
import Testimonials from '../components/Testimonials.astro';
import Clients from '../components/Clients.astro';
import BlogCard from '../components/BlogCard.astro';
import Faq from '../components/Faq.astro';
import CtaSection from '../components/CtaSection.astro';
import Icon from '../components/Icon.astro';
import { services } from '../data/services';
import { aiPillars, engagementModels, faq, methodSteps } from '../data/method';
import { differentials, productTypes, site, stats, technologies } from '../data/site';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
	.sort((a, b) => b.data.date.getTime() - a.data.date.getTime() || a.data.title.localeCompare(b.data.title))
	.slice(0, 3);

const pains = [
	{
		title: 'Meses até o primeiro feedback',
		description:
			'Projetos longos demais adiam a única coisa que importa no começo: descobrir se alguém quer o que você está construindo.',
	},
	{
		title: 'Orçamento no lugar errado',
		description:
			'Funcionalidades “essenciais” que ninguém usa consomem o dinheiro que deveria financiar o crescimento.',
	},
	{
		title: 'Time caro, cedo demais',
		description: 'Montar uma equipe técnica completa antes de validar o negócio aumenta o risco e o custo fixo.',
	},
];

const stages = [
	{
		name: 'Validar',
		from: 'Do guardanapo ao MVP',
		description: 'Descobrimos o que precisa ser provado e colocamos no ar a menor versão capaz de provar.',
	},
	{
		name: 'Lançar',
		from: 'Do MVP ao mercado',
		description: 'Produto publicado, métricas configuradas e usuários reais gerando aprendizado todos os dias.',
	},
	{
		name: 'Escalar',
		from: 'Do mercado ao crescimento',
		description: 'Evolução contínua, novas funcionalidades e arquitetura preparada para crescer com você.',
	},
];

const capabilities = [
	'Aplicativos iOS e Android',
	'Plataformas SaaS',
	'Agentes de IA',
	'MVPs para startups',
	'Sistemas sob medida',
	'Integrações e APIs',
	'Automação com IA',
	'UX Research',
	'UI Design',
	'Painéis de dados',
];
---

<Base
	description="A Kafé Apps cria aplicativos, plataformas, sistemas e soluções de IA sob medida — em código, com engenharia acelerada por IA. Software house em Niterói (RJ) que atende todo o Brasil."
>
	<!-- Início: o mascote -->
	<section class="hero" data-liquid="mascot" data-rail="Início">
		<div class="container hero-inner">
			<p class="eyebrow" data-reveal>Software house · Código + IA · {site.location.city}, {site.location.state}</p>
			<h1 class="display hero-title" data-split>Mais negócio, <em>menos software.</em></h1>
			<p class="lead hero-lead" data-reveal style="--delay: 0.35s">
				A Kafé Apps cria aplicativos, plataformas, sistemas e soluções de IA sob medida — em código, com
				engenheiros acelerados por inteligência artificial. Do MVP ao produto em escala, sem desperdício.
			</p>
			<div class="btn-row" data-reveal style="--delay: 0.5s">
				<a class="btn" href="/contato">Tirar minha ideia do papel <Icon name="arrow" class="arrow" /></a>
				<a class="btn btn-ghost" href="#servicos">Ver o que fazemos</a>
			</div>
			<ul role="list" class="hero-proof" data-reveal style="--delay: 0.65s">
				<li><Icon name="clock" size={18} /> Desde {site.foundingYear}</li>
				<li><Icon name="spark" size={18} /> Engenharia aumentada por IA</li>
				<li><Icon name="k" size={18} /> Metodologia 4Ds</li>
			</ul>
			<!-- No celular o mascote ganha um espaço só dele, longe do texto. -->
			<div class="hero-mascot" data-liquid-anchor aria-hidden="true"></div>
		</div>
		<Mascot />
		<a class="scroll-cue" href="#problema" aria-label="Role para a próxima seção">
			<span class="scroll-line" aria-hidden="true"></span>
			<span class="label">Role</span>
		</a>
	</section>

	<Marquee items={capabilities} />

	<!-- 01 · Problema: o relógio -->
	<section class="section" id="problema" data-liquid="clock" data-rail="Problema">
		<div class="container split">
			<div class="split-text">
				<SectionHead
					num="01"
					eyebrow="O problema"
					title="Boas ideias raramente morrem por serem ruins. <em>Morrem por demorar.</em>"
					lead="Meses de desenvolvimento antes do primeiro usuário, orçamento consumido por funcionalidades que ninguém pediu e um time caro antes de o negócio provar que funciona. Existe outro caminho."
				/>
				<ol role="list" class="list-lines">
					{
						pains.map((pain, index) => (
							<li data-reveal style={`--delay: ${index * 0.08}s`}>
								<span class="list-num label">0{index + 1}</span>
								<div>
									<h3>{pain.title}</h3>
									<p>{pain.description}</p>
								</div>
							</li>
						))
					}
				</ol>
			</div>
			<div class="stage" aria-hidden="true"></div>
		</div>
	</section>

	<!-- 02 · Virada: as barras de crescimento -->
	<section class="section" data-liquid="bars" data-rail="Virada">
		<div class="container split">
			<div class="split-text">
				<SectionHead
					num="02"
					eyebrow="A virada"
					title="Primeiro o negócio. <em>Depois o software.</em>"
					lead="Entendemos o negócio antes de escolher a tecnologia. Cada linha de código precisa ter um motivo para existir — e um resultado para entregar."
				/>
				<ol role="list" class="stages">
					{
						stages.map((stage, index) => (
							<li class="stage-item" data-reveal style={`--delay: ${index * 0.1}s`}>
								<span class="stage-from label">{stage.from}</span>
								<p class="stage-name">{stage.name}</p>
								<p class="stage-desc">{stage.description}</p>
							</li>
						))
					}
				</ol>
			</div>
			<div class="stage" aria-hidden="true"></div>
		</div>
	</section>

	<!-- 03 · Serviços: o líquido vira cada serviço -->
	<section class="section services" id="servicos" data-rail="Serviços">
		<div class="container split">
			<div class="split-text">
				<div data-liquid="code">
					<SectionHead
						num="03"
						eyebrow="O que fazemos"
						title="Do aplicativo à IA, <em>tudo em código.</em>"
						lead="Seis frentes, um só time: estratégia, design, engenharia e inteligência artificial trabalhando juntos — do primeiro rascunho à evolução contínua."
					/>
				</div>
				{
					services.map((service, index) => (
						<article class="block" data-liquid={service.shape}>
							<p class="block-num label">
								{String(index + 1).padStart(2, '0')} / {String(services.length).padStart(2, '0')}
							</p>
							<h3 class="block-title" data-reveal>
								{service.title}
							</h3>
							<p class="block-text" data-reveal style="--delay: 0.08s">
								{service.short}
							</p>
							<ul role="list" class="block-tags" data-reveal style="--delay: 0.14s">
								{service.keywords.map((keyword) => (
									<li class="tag">{keyword}</li>
								))}
							</ul>
							<a class="link-arrow" href={`/servicos/${service.slug}`} data-reveal style="--delay: 0.2s">
								Ver detalhes do serviço <Icon name="arrow" />
							</a>
						</article>
					))
				}
				<div class="block-more" data-reveal>
					<p class="label">E também</p>
					<ul role="list" class="chips">
						{productTypes.map((type) => <li class="tag">{type}</li>)}
					</ul>
				</div>
			</div>
			<div class="stage" aria-hidden="true"></div>
		</div>
	</section>

	<!-- 04 · Engenharia aumentada por IA -->
	<section class="section" id="ia" data-liquid="code-ai" data-rail="IA">
		<div class="container split">
			<div class="split-text">
				<SectionHead
					num="04"
					eyebrow="Engenharia aumentada por IA"
					title="Código escrito por pessoas. <em>Acelerado por IA.</em>"
					lead="Nossos engenheiros trabalham lado a lado com agentes de IA. A IA cuida do trabalho repetitivo; as pessoas cuidam das decisões, da arquitetura e da qualidade. Você recebe software sob medida, mais rápido."
				/>
				<ul role="list" class="pillars">
					{
						aiPillars.map((pillar, index) => (
							<li data-reveal style={`--delay: ${index * 0.06}s`}>
								<h3>{pillar.title}</h3>
								<p>{pillar.description}</p>
							</li>
						))
					}
				</ul>
				{
					technologies.length > 0 && (
						<div class="tools" data-reveal>
							<p class="label">Ferramentas do dia a dia</p>
							<ul role="list" class="chips">
								{technologies.map((tech) => (
									<li class="tag">{tech}</li>
								))}
							</ul>
						</div>
					)
				}
			</div>
			<div class="stage" aria-hidden="true"></div>
		</div>
	</section>

	<!-- 05 · Metodologia 4Ds: o ciclo -->
	<section class="section" id="metodo" data-rail="Método">
		<div class="container split">
			<div class="split-text">
				<div data-liquid="cycle-0">
					<SectionHead
						num="05"
						eyebrow="Metodologia 4Ds"
						title="Quatro etapas. <em>Nenhuma surpresa.</em>"
						lead="Nossa metodologia própria combina design inteligente, engenharia acelerada por IA e processos ágeis. Você acompanha cada etapa em tempo real."
					/>
				</div>
				{
					methodSteps.map((step, index) => (
						<article class="block step" data-liquid={`cycle-${index + 1}`}>
							<p class="block-num label">
								0{index + 1} · {step.coffee}
							</p>
							<h3 class="block-title" data-reveal>
								{step.name}
							</h3>
							<p class="step-title" data-reveal style="--delay: 0.06s">
								{step.title}
							</p>
							<p class="block-text" data-reveal style="--delay: 0.1s">
								{step.description}
							</p>
							<p class="step-output" data-reveal style="--delay: 0.16s">
								<Icon name="check" size={16} /> {step.output}
							</p>
						</article>
					))
				}
			</div>
			<div class="stage" aria-hidden="true"></div>
		</div>

		<div class="container models" data-liquid="rest">
			<p class="eyebrow" data-reveal>Formatos de trabalho</p>
			<div class="models-grid">
				{
					engagementModels.map((model, index) => (
						<article class="card model" data-reveal style={`--delay: ${index * 0.08}s`}>
							<span class="tag">{model.badge}</span>
							<h3 class="h3">{model.name}</h3>
							<p>{model.description}</p>
							<ul role="list">
								{model.items.map((item) => (
									<li>
										<Icon name="check" size={16} />
										{item}
									</li>
								))}
							</ul>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<!-- 06 · Clientes -->
	<section class="section" id="clientes" data-liquid="rest" data-rail="Clientes">
		<div class="container">
			<SectionHead
				num="06"
				eyebrow="Quem confia"
				title="Empresas que resolveram problemas reais <em>com a Kafé.</em>"
			/>
			<Clients />
			<div class="testimonials-wrap">
				<Testimonials />
			</div>
		</div>
	</section>

	<!-- 07 · Quem somos: o K -->
	<section class="section" id="sobre" data-liquid="k" data-rail="Sobre">
		<div class="container split">
			<div class="split-text">
				<SectionHead
					num="07"
					eyebrow="Quem somos"
					title="Nascemos em Niterói para <em>tirar ideias do papel.</em>"
				/>
				<div class="soul-copy" data-reveal>
					<p>
						A Kafé Apps nasceu em {site.foundingYear} com a missão de democratizar a criação de novos negócios e a
						geração de empregos por meio de tecnologias ágeis. Hoje, unimos engenharia de software e inteligência
						artificial para ajudar startups e empresas a validar ideias, lançar produtos e crescer.
					</p>
					<p class="soul-quote">
						Toda boa ideia já começou numa conversa de café. Nosso trabalho é garantir que ela não termine ali.
					</p>
				</div>
				<dl class="stats">
					{
						stats.map((stat, index) => (
							<div class="stat" data-reveal style={`--delay: ${index * 0.06}s`}>
								<dt>{stat.label}</dt>
								<dd>{stat.value}</dd>
							</div>
						))
					}
				</dl>
				<a class="link-arrow" href="/sobre" data-reveal>Conheça a Kafé <Icon name="arrow" /></a>
			</div>
			<div class="stage" aria-hidden="true"></div>
		</div>

		<div class="container" data-liquid="rest">
			<ul role="list" class="diffs">
				{
					differentials.map((item, index) => (
						<li class="diff" data-reveal style={`--delay: ${(index % 3) * 0.06}s`}>
							<Icon name="check" size={20} class="diff-icon" />
							<div>
								<h3>{item.title}</h3>
								<p>{item.description}</p>
							</div>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	{
		posts.length > 0 && (
			<section class="section" data-liquid="rest">
				<div class="container">
					<div class="head-row">
						<SectionHead
							eyebrow="Conteúdo"
							title="Ideias para quem <em>constrói produtos.</em>"
							lead="Artigos sobre produto, tecnologia e IA — e o PodKafé, nosso podcast no YouTube."
						/>
						<div class="head-actions" data-reveal>
							<a class="btn btn-ghost btn-sm" href="/blog">
								Ver todos os artigos
							</a>
						</div>
					</div>
					<div class="posts-grid">
						{posts.map((post, index) => (
							<BlogCard post={post} index={index} />
						))}
					</div>
				</div>
			</section>
		)
	}

	<section class="section" data-liquid="rest" data-rail="Dúvidas">
		<div class="container faq-layout">
			<SectionHead
				eyebrow="Perguntas frequentes"
				title="O que sempre aparece <em>no primeiro café.</em>"
				lead="Não achou sua dúvida? Mande uma mensagem — a gente responde rapidinho."
			>
				<div data-reveal style="--delay: 0.25s">
					<a class="link-arrow" href="/contato">Falar com a Kafé <Icon name="arrow" /></a>
				</div>
			</SectionHead>
			<Faq items={faq} />
		</div>
	</section>

	<CtaSection rail="Contato" />
</Base>

<style>
	/* Início ------------------------------------------------------------------ */
	.hero {
		position: relative;
		display: flex;
		align-items: center;
		min-height: 100vh;
		min-height: 100svh;
		padding-top: calc(var(--header-h) + 40px);
		padding-bottom: 120px;
	}

	.hero-inner {
		display: grid;
		gap: 28px;
		justify-items: start;
	}

	.hero-title {
		max-width: 13ch;
	}

	.hero-lead {
		max-width: 580px;
	}

	.hero .btn-row {
		margin-top: 8px;
	}

	.hero-proof {
		display: flex;
		flex-wrap: wrap;
		gap: 10px 26px;
		margin-top: 18px;
		font-size: var(--fs-small);
		color: var(--text-muted);
	}

	.hero-proof li {
		display: inline-flex;
		align-items: center;
		gap: 8px;
	}

	.hero-proof :global(svg) {
		color: var(--accent);
	}

	.hero-mascot {
		display: none;
	}

	/* Tela em pé: o mascote mora no fim do hero, abaixo do texto. */
	@media (max-aspect-ratio: 9/10) {
		.hero {
			align-items: stretch;
			padding-top: calc(var(--header-h) + 28px);
			padding-bottom: 8px;
		}

		.hero-inner {
			grid-template-rows: repeat(5, auto) 1fr;
			gap: 22px;
		}

		.hero-mascot {
			display: block;
			justify-self: stretch;
			min-height: 180px;
		}

		.hero .scroll-cue {
			display: none;
		}
	}

	.scroll-cue {
		position: absolute;
		left: 50%;
		bottom: 28px;
		display: grid;
		justify-items: center;
		gap: 10px;
		font-size: 0.68rem;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--text-dim);
		transform: translateX(-50%);
	}

	.scroll-line {
		position: relative;
		width: 1px;
		height: 46px;
		overflow: hidden;
		background: var(--line-strong);
	}

	.scroll-line::after {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(180deg, transparent, var(--white));
		animation: drip 2.2s var(--ease-in-out) infinite;
	}

	@keyframes drip {
		0% { transform: translateY(-100%); }
		100% { transform: translateY(100%); }
	}

	/* Listas em linhas (problema) ---------------------------------------------- */
	.list-lines {
		display: grid;
		border-top: 1px solid var(--line);
	}

	.list-lines li {
		display: grid;
		grid-template-columns: 48px 1fr;
		gap: 16px;
		padding: 26px 0;
		border-bottom: 1px solid var(--line);
	}

	.list-num {
		padding-top: 4px;
		font-size: var(--fs-xs);
		color: var(--text-dim);
	}

	.list-lines h3 {
		font-size: 1.3rem;
		letter-spacing: -0.02em;
	}

	.list-lines p {
		margin-top: 6px;
		color: var(--text-muted);
		font-size: var(--fs-small);
		max-width: 520px;
	}

	/* Virada --------------------------------------------------------------------- */
	.stages {
		display: grid;
		border-top: 1px solid var(--line);
	}

	.stage-item {
		display: grid;
		gap: 8px;
		padding: 26px 0;
		border-bottom: 1px solid var(--line);
	}

	.stage-from {
		font-size: 0.7rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--text-dim);
	}

	.stage-name {
		font-family: var(--font-display);
		font-size: clamp(2.6rem, 1.8rem + 3vw, 4.2rem);
		font-weight: 700;
		line-height: 0.95;
		letter-spacing: -0.045em;
		background: var(--gradient-metal);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
		justify-self: start;
		padding-right: 0.04em;
	}

	.stage-desc {
		max-width: 460px;
		color: var(--text-muted);
	}

	/* Blocos (serviços e etapas do método) ----------------------------------- */
	.block {
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: flex-start;
		gap: 14px;
		padding: 48px 0;
		border-top: 1px solid var(--line);
	}

	.block-num {
		font-size: 0.72rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--text-dim);
	}

	.block-title {
		font-size: clamp(2rem, 1.4rem + 2.2vw, 3.2rem);
		line-height: 1;
		letter-spacing: -0.04em;
	}

	.block-text {
		max-width: 520px;
		color: var(--text-muted);
		font-size: 1.08rem;
	}

	.block-tags,
	.chips {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
	}

	.block .link-arrow {
		margin-top: 6px;
	}

	.block-more {
		display: grid;
		gap: 14px;
		padding-top: 40px;
		border-top: 1px solid var(--line);
	}

	.block-more .label,
	.tools .label {
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--text-dim);
	}

	.step-title {
		font-weight: 600;
		font-size: 1.12rem;
	}

	.step-output {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 8px 12px;
		border: 1px solid var(--line-strong);
		border-radius: var(--radius-sm);
		font-size: var(--fs-xs);
		color: var(--text);
	}

	/* IA ------------------------------------------------------------------------- */
	.pillars {
		display: grid;
		gap: 0 32px;
		border-top: 1px solid var(--line);
	}

	.pillars li {
		padding: 24px 0;
		border-bottom: 1px solid var(--line);
	}

	.pillars h3 {
		font-size: 1.2rem;
		letter-spacing: -0.02em;
	}

	.pillars p {
		margin-top: 6px;
		font-size: var(--fs-small);
		color: var(--text-muted);
	}

	.tools {
		display: grid;
		gap: 14px;
		margin-top: 36px;
	}

	/* Formatos ------------------------------------------------------------------ */
	.models {
		margin-top: clamp(64px, 8vw, 120px);
	}

	.models-grid {
		display: grid;
		gap: 16px;
		margin-top: 24px;
	}

	.model {
		display: grid;
		gap: 14px;
		align-content: start;
		padding: clamp(24px, 3vw, 34px);
	}

	.model .tag {
		justify-self: start;
	}

	.model p {
		color: var(--text-muted);
		font-size: var(--fs-small);
	}

	.model ul {
		display: grid;
		gap: 10px;
		padding-top: 16px;

---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Mascot from '../components/Mascot.astro';
import Planet from '../components/Planet.astro';
import Art from '../components/Art.astro';
import { site } from '../data/site';
---

<Base title="Página não encontrada" description="A página que você procura não existe ou mudou de endereço." noindex>
	<!-- O mascote aparece tristinho aqui (data-mascot-mood="sad") e tenta animar a pessoa. -->
	<section
		class:list={['not-found', { 'nf-panel': !site.mascot && site.theme === 'claro' }]}
		data-liquid="mascot"
		data-mascot-mood="sad"
	>
		<div class="container nf-inner">
			<div class="nf-copy">
				<p class="eyebrow" data-reveal>Erro 404</p>
				<h1 class="display" data-split>Essa página <em>saiu de órbita.</em></h1>
				<p class="lead" data-reveal style="--delay: 0.2s">
					A página que você procura não existe ou mudou de endereço. Que tal recomeçar por aqui?
				</p>
				<div class="btn-row" data-reveal style="--delay: 0.3s">
					<a class="btn" href="/" data-mascot-look="love">Voltar para o início <Icon name="arrow" class="arrow" /></a>
					<a class="btn btn-ghost" href="/servicos">Ver serviços</a>
				</div>
			</div>
			{
				site.mascot ? (
					<div class="nf-stage">
						<div class="nf-mascot" data-liquid-anchor aria-hidden="true" />
						<button class="talk-pill" type="button" data-mascot-talk>
							<span class="talk-eyes" aria-hidden="true">
								<i />
								<i />
							</span>
							<span class="talk-label" data-mascot-label aria-live="polite">
								Anima ele
							</span>
						</button>
					</div>
				) : site.theme === 'escuro' ? (
					<div class="nf-stage nf-space">
						<Planet class="nf-planet" />
					</div>
				) : null
			}
		</div>
		<!-- Tema claro: a mesma fita de fios do topo da home. -->
		{!site.mascot && site.theme === 'claro' && <Art kind="fios" class="nf-fios" />}
		{site.mascot && <Mascot />}
	</section>
</Base>

<style>
	.not-found {
		display: flex;
		align-items: center;
		min-height: 100vh;
		min-height: 100svh;
		padding-block: calc(var(--header-h) + 40px) 120px;
	}

	.nf-inner {
		display: grid;
		gap: 32px;
		align-items: center;
	}

	.nf-copy {
		display: grid;
		gap: 24px;
		justify-items: start;
	}

	.nf-stage {
		display: grid;
		justify-items: center;
		gap: 6px;
	}

	.nf-mascot {
		justify-self: stretch;
		height: clamp(240px, 40vh, 460px);
	}

	/* Sem o mascote: o mesmo planeta da home, à deriva. */
	.nf-space {
		position: relative;
		justify-self: stretch;
		min-height: clamp(260px, 44vh, 480px);
	}

	.nf-space :global(.nf-planet) {
		position: absolute;
		top: 50%;
		left: 50%;
		width: min(130%, 640px);
		transform: translate(-50%, -50%);
	}

	.not-found {
		overflow-x: clip;
	}

	@media (min-width: 960px) {
		.nf-inner {
			grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
		}
	}

	.not-found .lead {
		max-width: 520px;
	}

	.nf-panel {
		position: relative;
		isolation: isolate;
		overflow: hidden;
		background: var(--bg-level-1);
		border-bottom: 1px solid var(--line);
	}

	.nf-panel .nf-inner {
		position: relative;
		z-index: 1;
	}

	.nf-panel :global(.nf-fios) {
		position: absolute;
		inset: 0;
		z-index: 0;
	}

	/* Tela em pé: a fita vira uma faixa logo abaixo do texto. */
	@media (max-aspect-ratio: 9/10) {
		.nf-panel {
			flex-direction: column;
			align-items: stretch;
			padding-bottom: 0;
		}

		.nf-panel :global(.nf-fios) {
			--fios-forma: faixa;
			position: relative;
			inset: auto;
			height: clamp(200px, 30svh, 260px);
			margin-top: 24px;
		}
	}
</style>

---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHead from '../../components/SectionHead.astro';
import MethodSteps from '../../components/MethodSteps.astro';
import Faq from '../../components/Faq.astro';
import CtaSection from '../../components/CtaSection.astro';
import Icon from '../../components/Icon.astro';
import { services, type Service } from '../../data/services';
import { site } from '../../data/site';

export const getStaticPaths = (() =>
	services.map((service) => ({ params: { slug: service.slug }, props: { service } }))) satisfies GetStaticPaths;

interface Props {
	service: Service;
}

const { service } = Astro.props;
const others = services.filter((item) => item.slug !== service.slug);

const serviceSchema = {
	'@context': 'https://schema.org',
	'@type': 'Service',
	name: service.title,
	serviceType: service.title,
	description: service.seo.description,
	url: new URL(`/servicos/${service.slug}`, site.url).href,
	provider: { '@id': `${site.url}/#organizacao` },
	areaServed: { '@type': 'Country', name: 'Brasil' },
};
---

<Base title={service.seo.title} description={service.seo.description} schema={[serviceSchema]}>
	<PageHero
		eyebrow={service.title}
		title={service.hero.title}
		lead={service.hero.lead}
		breadcrumbs={[{ label: 'Serviços', href: '/servicos' }, { label: service.title }]}
	>
		<div class="btn-row" data-reveal style="--delay: 0.3s">
			<a class="btn" href="/contato">Pedir uma proposta <Icon name="arrow" class="arrow" /></a>
			<a class="btn btn-ghost" href="#entregas">O que está incluído</a>
		</div>
	</PageHero>

	<section class="section intro" data-liquid="left">
		<div class="container intro-grid">
			<h2 class="h2" data-split set:html={service.intro.title} />
			<div class="intro-body">
				{service.intro.paragraphs.map((paragraph) => <p data-reveal>{paragraph}</p>)}
				<div class="for-who card" data-reveal>
					<h3 class="mono">Para quem é</h3>
					<ul role="list">
						{
							service.forWho.map((item) => (
								<li>
									<Icon name="check" size={18} />
									{item}
								</li>
							))
						}
					</ul>
				</div>
			</div>
		</div>
	</section>

	<section class="section" id="entregas" data-liquid="right">
		<div class="container">
			<SectionHead eyebrow="O que entregamos" title="Tudo o que entra <em>no projeto.</em>" />
			<ol role="list" class="deliverables">
				{
					service.deliverables.map((item, index) => (
						<li class="deliverable" data-reveal style={`--delay: ${(index % 3) * 0.08}s`}>
							<span class="mono">{String(index + 1).padStart(2, '0')}</span>
							<h3>{item.title}</h3>
							<p>{item.description}</p>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<section class="section" data-liquid="scatter">
		<div class="container">
			<SectionHead eyebrow="Na prática" title={service.highlights.title} />
			<div class:list={['highlights', `count-${service.highlights.items.length}`]}>
				{
					service.highlights.items.map((item, index) => (
						<article class="card highlight" data-reveal style={`--delay: ${index * 0.08}s`}>
							<h3 class="h3">{item.title}</h3>
							<p>{item.description}</p>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<section class="section" data-liquid="stream">
		<div class="container">
			<SectionHead
				eyebrow="Como trabalhamos"
				title="Método Sprint: <em>previsível do início ao fim.</em>"
				lead="Quatro etapas claras, entregas curtas e você acompanhando tudo em tempo real."
			/>
			<MethodSteps />
		</div>
	</section>

	<section class="section" data-liquid="rest">
		<div class="container faq-layout">
			<SectionHead eyebrow="Perguntas frequentes" title="Dúvidas sobre <em>este serviço.</em>" />
			<Faq items={service.faq} />
		</div>
	</section>

	<section class="section others" data-liquid="rest">
		<div class="container">
			<p class="eyebrow" data-reveal>Outros serviços</p>
			<ul role="list" class="others-list">
				{
					others.map((item) => (
						<li data-reveal>
							<a href={`/servicos/${item.slug}`}>
								<Icon name={item.icon} size={22} />
								<span>{item.title}</span>
								<Icon name="arrow-up-right" size={20} class="others-arrow" />
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<CtaSection
		title="Vamos tirar o seu projeto <em>do papel?</em>"
		lead="Conte o que você quer construir e receba uma proposta clara, dividida por sprints — sem compromisso."
	/>
</Base>

<style>
	.intro {
		padding-top: clamp(40px, 5vw, 80px);
	}

	.intro-grid {
		display: grid;
		gap: 40px;
	}

	.intro-body {
		display: grid;
		gap: 22px;
		align-content: start;
		color: var(--text-muted);
		font-size: 1.1rem;
	}

	.for-who {
		margin-top: 12px;
		padding: clamp(24px, 3vw, 34px);
	}

	.for-who h3 {
		margin-bottom: 18px;
		font-size: 0.75rem;
		font-weight: 500;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--text);
	}

	.for-who ul {
		display: grid;
		gap: 14px;
	}

	.for-who li {
		display: flex;
		gap: 12px;
		font-size: var(--fs-small);
		color: var(--text);
	}

	.for-who li :global(svg) {
		flex: none;
		margin-top: 3px;
		color: var(--accent);
	}

	.deliverables {
		display: grid;
		gap: 0 40px;
	}

	.deliverable {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 6px 18px;
		padding: 28px 0;
		border-top: 1px solid var(--line);
	}

	.deliverable .mono {
		grid-row: span 2;
		font-size: var(--fs-xs);
		color: var(--accent);
		padding-top: 4px;
	}

	.deliverable h3 {
		font-size: 1.15rem;
		font-weight: 550;
		letter-spacing: -0.02em;
	}

	.deliverable p {
		font-size: var(--fs-small);
		color: var(--text-muted);
	}

	.highlights {
		display: grid;
		gap: 16px;
	}

	.highlight {
		display: grid;
		gap: 14px;
		align-content: start;
		padding: clamp(26px, 3vw, 38px);
	}

	.highlight p {
		color: var(--text-muted);
		font-size: var(--fs-small);
	}

	.faq-layout {
		display: grid;
		gap: 0 64px;
	}

	.others {
		padding-top: 0;
	}

	.others-list {
		display: grid;
		margin-top: 28px;
		border-top: 1px solid var(--line);
	}

	.others-list a {
		display: flex;
		align-items: center;
		gap: 18px;
		padding: 24px 0;
		border-bottom: 1px solid var(--line);
		font-size: clamp(1.2rem, 1rem + 1vw, 1.75rem);
		font-weight: 450;
		letter-spacing: -0.03em;
		color: var(--text-muted);
		transition:
			color 0.3s ease,
			padding 0.5s var(--ease-out);
	}

	.others-list a :global(svg:first-child) {
		color: var(--accent);
		flex: none;
	}

	.others-list a :global(.others-arrow) {
		margin-left: auto;
		flex: none;
		transition: transform 0.5s var(--ease-out);
	}

	.others-list a:hover {
		color: var(--text);
		padding-left: 12px;
	}

	.others-list a:hover :global(.others-arrow) {
		transform: translate(4px, -4px);
		color: var(--text);
	}

	@media (min-width: 720px) {
		.deliverables {
			grid-template-columns: repeat(2, 1fr);
		}

		.highlights {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (min-width: 960px) {
		.intro-grid {
			grid-template-columns: 1fr 1fr;
			gap: 64px;
		}

		.deliverables {
			grid-template-columns: repeat(3, 1fr);
		}

		.highlights.count-3 {
			grid-template-columns: repeat(3, 1fr);
		}

		.highlights.count-4 {
			grid-template-columns: repeat(4, 1fr);
		}

		.faq-layout {
			grid-template-columns: 0.9fr 1.1fr;
		}
	}
</style>
